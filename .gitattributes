# Shell scripts must use LF line endings so they run under bash/dash on
# Linux, WSL, and macOS even when the repo is checked out or edited on
# Windows. CRLF here breaks `set -euo pipefail` (read as `pipefail\r`) and
# corrupts every other line, which silently broke the GGML native build and
# the CUDA arch-detection fallback.
*.sh text eol=lf
# Localization tables have a canonical LF format verified by the app's tests.
TensorAgent/src/TensorAgent.Core/Localization/**/*.json text eol=lf
TensorAgent/src/TensorAgent.Sharing/Localization/**/*.json text eol=lf
# Docker RUN heredocs are shell scripts too.
Dockerfile* text eol=lf
# PDF fixtures are hash-pinned embedded resources, even when their bytes look
# like text. core.autocrlf must not rewrite their streams or xref offsets.
InferenceWeb.Tests/Fixtures/Knowledge/*.pdf -text

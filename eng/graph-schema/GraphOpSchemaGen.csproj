<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regenerates the graph op protocol's three definitions from TensorSharp.Core/Graph/Schema/graph-ops.json.
       Write the generated files: "dotnet run (project eng/graph-schema)"; with the check argument it only reports
       stale files and exits 1 (see eng/graph-schema/README.md). It references no TensorSharp project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TensorSharpSkipGgmlNative>true</TensorSharpSkipGgmlNative>
    <TensorSharpSkipMlxNative>true</TensorSharpSkipMlxNative>
  </PropertyGroup>
</Project>

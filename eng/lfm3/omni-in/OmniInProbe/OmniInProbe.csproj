<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TensorSharpSkipGgmlNative>true</TensorSharpSkipGgmlNative>
    <TensorSharpSkipMlxNative>true</TensorSharpSkipMlxNative>
    <!-- The deployment target copies an existing library only; it never
         configures or compiles GGML. Callers can select an isolated build. -->
    <GgmlNativeBuildDir Condition="'$(GgmlNativeBuildDir)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildProjectDirectory)/../../../../TensorSharp.GGML.Native/build-windows</GgmlNativeBuildDir>
    <GgmlNativeBuildDir Condition="'$(GgmlNativeBuildDir)' == ''">$(MSBuildProjectDirectory)/../../../../TensorSharp.GGML.Native/build</GgmlNativeBuildDir>
    <GgmlNativeBinaryName Condition="'$(GgmlNativeBinaryName)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">GgmlOps.dll</GgmlNativeBinaryName>
    <GgmlNativeBinaryName Condition="'$(GgmlNativeBinaryName)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">libGgmlOps.so</GgmlNativeBinaryName>
    <GgmlNativeBinaryName Condition="'$(GgmlNativeBinaryName)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">libGgmlOps.dylib</GgmlNativeBinaryName>
    <OmniInProbeRequireGgmlNative Condition="'$(OmniInProbeRequireGgmlNative)' == ''">false</OmniInProbeRequireGgmlNative>
  </PropertyGroup>
  <ItemGroup>
    
    <ProjectReference Include="../../../../TensorSharp.Models/TensorSharp.Models.csproj" />
  </ItemGroup>
  <Target Name="CopyGgmlNativeBinary" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_OmniInProbeGgmlSource></_OmniInProbeGgmlSource>
      <!-- Match the hosts' Release output when both layouts are present, but
           select exactly one source instead of overwriting the destination twice. -->
      <_OmniInProbeGgmlSource Condition="'$(GgmlNativeBinaryName)' != '' And Exists('$(GgmlNativeBuildDir)/Release/$(GgmlNativeBinaryName)')">$(GgmlNativeBuildDir)/Release/$(GgmlNativeBinaryName)</_OmniInProbeGgmlSource>
      <_OmniInProbeGgmlSource Condition="'$(_OmniInProbeGgmlSource)' == '' And '$(GgmlNativeBinaryName)' != '' And Exists('$(GgmlNativeBuildDir)/$(GgmlNativeBinaryName)')">$(GgmlNativeBuildDir)/$(GgmlNativeBinaryName)</_OmniInProbeGgmlSource>
      <_OmniInProbeNativeOutput>$(TargetDir)</_OmniInProbeNativeOutput>
      <_OmniInProbeNativeOutput Condition="'$(_OmniInProbeNativeOutput)' == ''">$(OutDir)</_OmniInProbeNativeOutput>
      <_OmniInProbeNativeOutput Condition="'$(_OmniInProbeNativeOutput)' == ''">$(OutputPath)</_OmniInProbeNativeOutput>
    </PropertyGroup>
    <Error Condition="'$(_OmniInProbeGgmlSource)' == '' And '$(OmniInProbeRequireGgmlNative)' == 'true'"
           Text="OmniInProbe GGML deployment unavailable: no prebuilt $(GgmlNativeBinaryName) under $(GgmlNativeBuildDir) or its Release directory. Build GGML separately or set -p:GgmlNativeBuildDir to the matching prebuilt directory. No native build was attempted." />
    <Warning Condition="'$(_OmniInProbeGgmlSource)' == '' And '$(OmniInProbeRequireGgmlNative)' != 'true'"
             Text="OmniInProbe GGML deployment unavailable: no prebuilt $(GgmlNativeBinaryName) under $(GgmlNativeBuildDir) or its Release directory. Managed build completion does not establish GGML runtime availability; any existing output library is unchanged. No native build was attempted." />
    <Error Condition="'$(_OmniInProbeGgmlSource)' != '' And '$(_OmniInProbeNativeOutput)' == ''"
           Text="OmniInProbe cannot deploy its prebuilt GGML library without a resolved output directory." />
    <MakeDir Directories="$(_OmniInProbeNativeOutput)" Condition="'$(_OmniInProbeGgmlSource)' != ''" />
    <Copy SourceFiles="$(_OmniInProbeGgmlSource)" DestinationFolder="$(_OmniInProbeNativeOutput)"
          SkipUnchangedFiles="true" Condition="'$(_OmniInProbeGgmlSource)' != ''" />
    <Message Importance="high" Condition="'$(_OmniInProbeGgmlSource)' != ''"
             Text="OmniInProbe prebuilt GGML runtime: $(_OmniInProbeGgmlSource) -> $(_OmniInProbeNativeOutput). Copying a library does not qualify its runtime backend." />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TensorSharpSkipGgmlNative>true</TensorSharpSkipGgmlNative>
    <TensorSharpSkipMlxNative>true</TensorSharpSkipMlxNative>
    <!-- The deployment target copies an existing library only; it never
         configures or compiles GGML. Callers can select an isolated build. -->
    <GgmlNativeBuildDir Condition="'$(GgmlNativeBuildDir)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildProjectDirectory)/../../../TensorSharp.GGML.Native/build-windows</GgmlNativeBuildDir>
    <GgmlNativeBuildDir Condition="'$(GgmlNativeBuildDir)' == ''">$(MSBuildProjectDirectory)/../../../TensorSharp.GGML.Native/build</GgmlNativeBuildDir>
    <GgmlNativeBinaryName Condition="'$(GgmlNativeBinaryName)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">GgmlOps.dll</GgmlNativeBinaryName>
    <GgmlNativeBinaryName Condition="'$(GgmlNativeBinaryName)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">libGgmlOps.so</GgmlNativeBinaryName>
    <GgmlNativeBinaryName Condition="'$(GgmlNativeBinaryName)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">libGgmlOps.dylib</GgmlNativeBinaryName>
    <MultiModelUnloadRequireGgmlNative Condition="'$(MultiModelUnloadRequireGgmlNative)' == ''">false</MultiModelUnloadRequireGgmlNative>
  </PropertyGroup>
  <ItemGroup>
    
    <ProjectReference Include="../../../TensorSharp.Models/TensorSharp.Models.csproj" />
  </ItemGroup>
  <Target Name="CopyGgmlNativeBinary" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_MultiModelUnloadGgmlSource></_MultiModelUnloadGgmlSource>
      <!-- Match the hosts' Release output when both layouts are present, but
           select exactly one source instead of overwriting the destination twice. -->
      <_MultiModelUnloadGgmlSource Condition="'$(GgmlNativeBinaryName)' != '' And Exists('$(GgmlNativeBuildDir)/Release/$(GgmlNativeBinaryName)')">$(GgmlNativeBuildDir)/Release/$(GgmlNativeBinaryName)</_MultiModelUnloadGgmlSource>
      <_MultiModelUnloadGgmlSource Condition="'$(_MultiModelUnloadGgmlSource)' == '' And '$(GgmlNativeBinaryName)' != '' And Exists('$(GgmlNativeBuildDir)/$(GgmlNativeBinaryName)')">$(GgmlNativeBuildDir)/$(GgmlNativeBinaryName)</_MultiModelUnloadGgmlSource>
      <_MultiModelUnloadNativeOutput>$(TargetDir)</_MultiModelUnloadNativeOutput>
      <_MultiModelUnloadNativeOutput Condition="'$(_MultiModelUnloadNativeOutput)' == ''">$(OutDir)</_MultiModelUnloadNativeOutput>
      <_MultiModelUnloadNativeOutput Condition="'$(_MultiModelUnloadNativeOutput)' == ''">$(OutputPath)</_MultiModelUnloadNativeOutput>
    </PropertyGroup>
    <Error Condition="'$(_MultiModelUnloadGgmlSource)' == '' And '$(MultiModelUnloadRequireGgmlNative)' == 'true'"
           Text="MultiModelUnload GGML deployment unavailable: no prebuilt $(GgmlNativeBinaryName) under $(GgmlNativeBuildDir) or its Release directory. Build GGML separately or set -p:GgmlNativeBuildDir to the matching prebuilt directory. No native build was attempted." />
    <Warning Condition="'$(_MultiModelUnloadGgmlSource)' == '' And '$(MultiModelUnloadRequireGgmlNative)' != 'true'"
             Text="MultiModelUnload GGML deployment unavailable: no prebuilt $(GgmlNativeBinaryName) under $(GgmlNativeBuildDir) or its Release directory. Managed build completion does not establish GGML runtime availability; any existing output library is unchanged. No native build was attempted." />
    <Error Condition="'$(_MultiModelUnloadGgmlSource)' != '' And '$(_MultiModelUnloadNativeOutput)' == ''"
           Text="MultiModelUnload cannot deploy its prebuilt GGML library without a resolved output directory." />
    <MakeDir Directories="$(_MultiModelUnloadNativeOutput)" Condition="'$(_MultiModelUnloadGgmlSource)' != ''" />
    <Copy SourceFiles="$(_MultiModelUnloadGgmlSource)" DestinationFolder="$(_MultiModelUnloadNativeOutput)"
          SkipUnchangedFiles="true" Condition="'$(_MultiModelUnloadGgmlSource)' != ''" />
    <Message Importance="high" Condition="'$(_MultiModelUnloadGgmlSource)' != ''"
             Text="MultiModelUnload prebuilt GGML runtime: $(_MultiModelUnloadGgmlSource) -> $(_MultiModelUnloadNativeOutput). Copying a library does not qualify its runtime backend." />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../TensorSharp.Models/TensorSharp.Models.csproj"
                      AdditionalProperties="TensorSharpSkipGgmlNative=true;TensorSharpSkipMlxNative=true" />
  </ItemGroup>
  <!-- Native deployment is explicit. Never copy the repository's possibly
       stale native output over the invoking runner's qualified binary. -->
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeSnapshot)' == ''">
    <ProjectReference Include="../../../TensorSharp.Runtime/TensorSharp.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeSnapshot)' != ''">
    <Reference Include="TensorSharp.Runtime">
      <HintPath>$(RuntimeSnapshot)/TensorSharp.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>

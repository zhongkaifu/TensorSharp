<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup Condition="'$(ValidationRuntimeDirectory)' != ''">
    <Reference Include="$(ValidationRuntimeDirectory)/*.dll" Exclude="$(ValidationRuntimeDirectory)/GgmlOps.dll" />
  </ItemGroup>
  <Target Name="RequireFrozenValidationRuntime" BeforeTargets="ResolveReferences"
          Condition="'$(ValidationRuntimeDirectory)' == ''">
    <Error Text="Set ValidationRuntimeDirectory to an already qualified SDK publish. This diagnostic never rebuilds product projects." />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup Condition="'$(ValidationRuntimeDirectory)' == ''">
    <ProjectReference Include="../../../TensorSharp.Models/TensorSharp.Models.csproj"
                      AdditionalProperties="TensorSharpSkipGgmlNative=true;TensorSharpSkipMlxNative=true" />
  </ItemGroup>
  <ItemGroup Condition="'$(ValidationRuntimeDirectory)' != ''">
    <Reference Include="$(ValidationRuntimeDirectory)/*.dll" Exclude="$(ValidationRuntimeDirectory)/GgmlOps.dll" />
  </ItemGroup>
</Project>

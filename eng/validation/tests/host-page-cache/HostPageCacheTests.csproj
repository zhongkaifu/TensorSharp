<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux behaviour of TensorSharp.Runtime/HostPageCache.cs (the in-process eviction behind a cold
       benchmark-suite row) on a real kernel: WSL or any Linux host, no GPU, no model. Usage is in Program.cs.
       Compiles the one source file directly so it builds with nothing but the SDK (no package restore). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../TensorSharp.Runtime/HostPageCache.cs" Link="HostPageCache.cs" />
  </ItemGroup>
</Project>

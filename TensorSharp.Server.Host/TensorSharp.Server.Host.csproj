<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <OutputPath>bin\</OutputPath>
	  <IsPackable>true</IsPackable>
	  <Description>ASP.NET Core server host package for TensorSharp with embedding and chat inference, web UI, and Ollama/OpenAI-compatible APIs.</Description>
	  <PackageTags>$(TensorSharpPackageTags);server;host;aspnetcore;openai;ollama;embeddings;web</PackageTags>
	  <!-- TensorSharp's methods compiled fully optimized at their first call, not first at tier 0: a request's first decode
	       steps trace and record each step shape through code that had not been promoted yet (Qwen3.8 Flash Next ISTA + MTP
	       on an A40, the CLI with tiering off: the first request's eight trunk recordings 260-305 ms against 175-188 ms,
	       short-prompt decode 100-104 tok/s against 111-113; model load 27-31 s either way). Tiering itself stays on, so the
	       framework's precompiled (ReadyToRun) methods that run hot are recompiled for this CPU: with it off they ran
	       precompiled for good, and the BCL's vector exp behind every SiLU and softmax of the managed CPU lane took a
	       function call per lane (LFM3-1.7B Q4_K_M, M5 Pro, the server at one stream: 78.0 -> 96.9 tok/s decode, 686 -> 618 ms
	       time to first token for 512 tokens; the same bits). -->
	  <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
  </PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="InferenceWeb.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
		<!-- Share the audited source bundle with TensorAgent. SkillHostOptions scans
             this conventional skills directory beside the deployed binary. -->
		<Content Include="..\TensorAgent\skills\**\*"
		         Exclude="..\TensorAgent\skills\verdicts.json;..\TensorAgent\skills\**\__pycache__\**\*;..\TensorAgent\skills\**\node_modules\**\*"
		         Link="skills/%(RecursiveDir)%(Filename)%(Extension)"
		         CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\TensorSharp.Chat\WebUi\studio.js" Link="wwwroot\studio.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\TensorSharp.Chat\WebUi\studio.css" Link="wwwroot\studio.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\TensorSharp.Chat\WebUi\mask-editor.js" Link="wwwroot\mask-editor.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\TensorSharp.Chat\WebUi\mask-editor.css" Link="wwwroot\mask-editor.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<PropertyGroup>
		<GgmlNativeBuildDir>$(MSBuildProjectDirectory)/../TensorSharp.GGML.Native/build</GgmlNativeBuildDir>
		<GgmlNativeBuildDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildProjectDirectory)/../TensorSharp.GGML.Native/build-windows</GgmlNativeBuildDir>
		<GgmlNativeBinaryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">GgmlOps.dll</GgmlNativeBinaryName>
		<GgmlNativeBinaryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libGgmlOps.dylib</GgmlNativeBinaryName>
		<GgmlNativeBinaryName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libGgmlOps.so</GgmlNativeBinaryName>
		<MlxNativeInstallDir>$(MSBuildProjectDirectory)/../TensorSharp.Backends.MLX/Native/dist</MlxNativeInstallDir>
		<MlxNativeBinaryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmlxc.dylib</MlxNativeBinaryName>
		<MlxNativeDependencyName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmlx.dylib</MlxNativeDependencyName>
		<MlxNativeJacclName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libjaccl.dylib</MlxNativeJacclName>
		<!-- MLX's precompiled Metal kernels; mlx loads it from the directory holding
         libmlx.dylib, so it has to travel with the dylibs. See
         TensorSharp.Backends.MLX.csproj for the full rationale. -->
		<MlxNativeMetallibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">mlx.metallib</MlxNativeMetallibName>
	</PropertyGroup>
	<Target Name="CopyGgmlNativeBinary" AfterTargets="Build" Condition="'$(GgmlNativeBinaryName)' != ''">
		<ItemGroup>
			<GgmlNativeBinary Include="$(GgmlNativeBuildDir)/$(GgmlNativeBinaryName)" Condition="Exists('$(GgmlNativeBuildDir)/$(GgmlNativeBinaryName)')" />
			<GgmlNativeBinary Include="$(GgmlNativeBuildDir)/Release/$(GgmlNativeBinaryName)" Condition="Exists('$(GgmlNativeBuildDir)/Release/$(GgmlNativeBinaryName)')" />
		</ItemGroup>
		<Copy SourceFiles="@(GgmlNativeBinary)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
	</Target>
	<Target Name="CopyMlxNativeBinary" AfterTargets="Build" Condition="'$(MlxNativeBinaryName)' != ''">
		<ItemGroup>
			<MlxNativeBinary Include="$(MlxNativeInstallDir)/$(MlxNativeBinaryName)" Condition="Exists('$(MlxNativeInstallDir)/$(MlxNativeBinaryName)')" />
			<MlxNativeBinary Include="$(MlxNativeInstallDir)/$(MlxNativeDependencyName)" Condition="'$(MlxNativeDependencyName)' != '' And Exists('$(MlxNativeInstallDir)/$(MlxNativeDependencyName)')" />
			<MlxNativeBinary Include="$(MlxNativeInstallDir)/$(MlxNativeJacclName)" Condition="'$(MlxNativeJacclName)' != '' And Exists('$(MlxNativeInstallDir)/$(MlxNativeJacclName)')" />
			<MlxNativeBinary Include="$(MlxNativeInstallDir)/lib/$(MlxNativeJacclName)" Condition="'$(MlxNativeJacclName)' != '' And Exists('$(MlxNativeInstallDir)/lib/$(MlxNativeJacclName)')" />
			<MlxNativeBinary Include="$(MlxNativeInstallDir)/$(MlxNativeMetallibName)" Condition="'$(MlxNativeMetallibName)' != '' And Exists('$(MlxNativeInstallDir)/$(MlxNativeMetallibName)')" />
			<MlxNativeBinary Include="$(MlxNativeInstallDir)/lib/$(MlxNativeMetallibName)" Condition="'$(MlxNativeMetallibName)' != '' And !Exists('$(MlxNativeInstallDir)/$(MlxNativeMetallibName)') And Exists('$(MlxNativeInstallDir)/lib/$(MlxNativeMetallibName)')" />
		</ItemGroup>
		<Copy SourceFiles="@(MlxNativeBinary)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
	</Target>

  <ItemGroup>
    <ProjectReference Include="..\TensorSharp.Server\TensorSharp.Server.csproj" />
    <ProjectReference Include="..\TensorSharp.Telemetry\TensorSharp.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTTP server spans and ASP.NET Core metrics for the opt-in OpenTelemetry pipeline;
         the rest of the SDK comes from TensorSharp.Telemetry. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
  </ItemGroup>

</Project>

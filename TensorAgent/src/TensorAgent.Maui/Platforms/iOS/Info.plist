<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- iOS 27 requires the scene lifecycle when linking against the iOS 27 SDK.
	     Keep one window because TensorAgent's shell and host are app singletons. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>

	<!-- The Web UI is served by an in-process HTTP listener on 127.0.0.1, so
	     App Transport Security must allow plain-http loopback traffic. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Usage strings for the native attach/camera/mic/dictation toolbar. iOS
	     kills an app on the spot if it touches one of these without a string. -->
	<key>NSCameraUsageDescription</key>
	<string>TensorAgent uses the camera to take pictures you want the on-device model to look at.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TensorAgent uses the microphone to dictate messages and to attach audio for the on-device model.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TensorAgent reads photos and videos you choose to attach to a conversation.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>TensorAgent transcribes your dictation into the message box.</string>

	<!-- These show the app's Documents folder in Files and Finder, and that folder
	     is empty: nothing in the app reads or writes Documents. Conversations,
	     settings and installed skills live in Library/Application Support; model
	     weights, uploads, workspaces, generated files and logs in Library/Caches.
	     Files shows neither. A sideloaded model comes in through the Files picker
	     on the Models page, which copies it into the store, and a generated file
	     goes out through QuickLook or the share sheet. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>

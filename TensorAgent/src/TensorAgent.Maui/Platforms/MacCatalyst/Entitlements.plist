<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mono needs JIT under the hardened runtime. App Sandbox stays off:
         TensorSharp applies its own Seatbelt profiles to desktop skills. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Hardened runtime resource access for existing capture/dictation features.
         Info.plist usage strings and the user's permission are still required. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
</dict>
</plist>

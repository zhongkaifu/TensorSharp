<Project>
  <!--
    Keep the engine's exports alive in a Release device build.

    The whole engine is linked statically and reached by dlsym through
    NativeLibrary.GetMainProgramHandle() (GgmlNative.ImportResolver), so every
    TSGgml_* the managed side imports has to survive into the executable's symbol
    table. The link DOES export them (-Wl,-exported_symbol,_TSGgml_* on the
    NativeReference), and Release then runs, as a separate step,
        xcrun strip -i -s <obj>/mtouch-symbols.list <executable>
    where 'strip -s file' keeps ONLY the symbols named in that file. Nothing put
    TSGgml_ in it, so they were stripped straight back out and the app came up with
    ggmlCpuAvailable=false / ggmlMetalAvailable=false and could load no model at all.

    ReferenceNativeSymbol is the SDK's own way to say 'keep this one': the items are
    written into that very list (Xamarin.Shared.Sdk.targets, WriteLinesToFile to
    $(_MtouchSymbolsList)) and also become -u link roots.

    NOT MtouchNoSymbolStrip=true. That also restores the exports, but it keeps every
    symbol: the executable grows from 78 MB to 190 MB and the app then dies at launch
    with SIGABRT inside load_aot_module, before any managed code runs. Measured on
    device.

    Names carry no leading underscore: the linker adds one for -u. Native source export manifest; 282 symbols.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <ReferenceNativeSymbol Include="TSGgml_ActivationGradF32" SymbolType="Function" />
    <ReferenceNativeSymbol Include="TSGgml_AdamF32" SymbolType="Function" />
    <ReferenceNativeSymbol Include="TSGgml_AddIdF32" SymbolType="Function" />
    <ReferenceNativeSymbol Include="TSGgml_AddmmBatchF32" SymbolType="Function" />
    <ReferenceNativeSymbol Include="TSGgml_AddmmF32" SymbolType="Function" />
    <ReferenceNativeSymbol Include="TSGgml_AddmmQuantBatchF32" SymbolType="Function" />
    <ReferenceNativeSymbol Include="TSGgml_AddmmQuantF32" SymbolType="Function" />

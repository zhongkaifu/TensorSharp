<Project Sdk="Microsoft.NET.Sdk">

  <!-- TensorAgent: a .NET MAUI app that hosts its own Web UI (wwwroot/, below) in a
       WebView behind an in-process loopback HTTP server, with the TensorSharp engine in
       the same process. One project, three heads:

         net10.0-ios                   iPhone and iPad. Statically links TensorSharp's
                                       GgmlOps.xcframework, embeds CPython and runs the
                                       model's code inside the app.
         net10.0-maccatalyst           The Mac desktop app. Ships the desktop
                                       libGgmlOps.dylib and runs the model's code as real
                                       processes confined by Seatbelt, as the desktop hosts do.
         net10.0-windows10.0.19041.0   The Windows desktop app, built on Windows. Ships
                                       GgmlOps.dll.

       Build the Apple heads only with the user-local SDK that carries the maui-ios and
       maui-maccatalyst workloads, and the Windows head with maui-windows (see
       ../../README.md). -->

  <PropertyGroup>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- The inner build's platform (ios, maccatalyst, windows), for the conditions below.
         The SDK sets TargetPlatformIdentifier only after the project body is evaluated. -->
    <TensorAgentPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</TensorAgentPlatform>
    <OutputType>Exe</OutputType>
    <RootNamespace>TensorAgent.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <ApplicationTitle>TensorAgent</ApplicationTitle>
    <ApplicationId>ai.tensorsharp.tensoragent</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- 17.0 matches build-ios.sh's deployment target for the xcframework; the
         static archive would refuse to link into an app that claims to run on
         an older OS than the archive was built for. -->
    <SupportedOSPlatformVersion Condition="'$(TensorAgentPlatform)' == 'ios'">17.0</SupportedOSPlatformVersion>
    <!-- Mac Catalyst 17.0 is macOS 14. The engine library beside the app is built by
         build-macos.sh for the building Mac's own macOS unless MACOSX_DEPLOYMENT_TARGET
         says otherwise, and that, not this number, is what decides the oldest Mac it
         loads on. -->
    <SupportedOSPlatformVersion Condition="'$(TensorAgentPlatform)' == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TensorAgentPlatform)' == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(TensorAgentPlatform)' == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- The desktop heads build for the building machine's architecture, because the
         engine library they ship is built for that architecture only (build-macos.sh,
         build-windows.ps1). A Mac Catalyst Release build would otherwise default to a
         universal x64+arm64 app around a single-architecture library. -->
    <RuntimeIdentifier Condition="'$(TensorAgentPlatform)' == 'maccatalyst' And '$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier.Replace('osx-', 'maccatalyst-'))</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(TensorAgentPlatform)' == 'windows' And '$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>

    <!-- An unpackaged Windows app that carries the Windows App SDK runtime with it, so it
         runs from its build output with nothing to install first. -->
    <WindowsPackageType Condition="'$(TensorAgentPlatform)' == 'windows'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(TensorAgentPlatform)' == 'windows'">true</WindowsAppSDKSelfContained>

    <!-- Trimming is mandatory on iOS. partial (= MtouchLink SdkOnly) trims the
         BCL/framework only and copies every TensorSharp assembly whole; the
         engine's op registries and model loaders are reflection-heavy and the
         TrimmerRootAssembly items below keep them rooted even if a later change
         moves to full trimming. -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- The phone links GgmlOps statically from the xcframework (NativeReference
         below), and the desktop heads get their engine library from
         TensorAgentBuildDesktopEngine below, so the native builds in the referenced
         backend projects never run for this project. These properties are also
         forwarded to the referenced projects as global properties (AdditionalProperties
         on each ProjectReference) because a plain csproj property never flows across a
         ProjectReference on its own. The value is the same for every head, so two inner
         builds of this project never ask for the same referenced project with two
         different sets of global properties. -->
    <TensorSharpSkipGgmlNative>true</TensorSharpSkipGgmlNative>
    <TensorSharpSkipMlxNative>true</TensorSharpSkipMlxNative>
    <!-- TensorSharp.Models builds its net10.0-ios and net10.0-maccatalyst slices only
         when asked, because the desktop hosts must not pay for Apple targets they cannot
         use. Those slices are where the AVFoundation/ImageIO media provider lives, which
         is what lets the app decode a HEIC photo straight off the camera. The Windows
         head uses the net10.0 slice and its desktop media provider. -->
    <TensorSharpAppleTargets Condition="'$(TensorAgentPlatform)' != 'windows'">true</TensorSharpAppleTargets>
    <TensorSharpNativeSkipProperties>TensorSharpSkipGgmlNative=true;TensorSharpSkipMlxNative=true</TensorSharpNativeSkipProperties>
    <TensorSharpNativeSkipProperties Condition="!$([MSBuild]::IsOSPlatform('windows'))">$(TensorSharpNativeSkipProperties);TensorSharpAppleTargets=true</TensorSharpNativeSkipProperties>

    <!-- LLVM codegen for device Release builds so the AdvSimd/Vector128 paths in
         TensorSharp.Core get real vector code; ignored for the simulator. The Mac app
         gets it too: it runs on Mono like the phone (.NET ships no CoreCLR for Mac
         Catalyst), and the SDK turns LLVM on by default for iOS and tvOS only.
         MEASURED with the in-process SpeculationBench, Gemma 4 E2B on Metal, M5 Pro,
         three rotated runs each: steady-state decode 74.7 tok/s against 72.5 without
         it (the desktop hosts on CoreCLR: 76.8), the first token of a turn 20-30%
         sooner, and speculative decoding on quoted text 269-302 tok/s against 237-268.
         The price is a Release build of about three minutes instead of one. -->
    <MtouchUseLlvm Condition="'$(Configuration)' == 'Release' And ('$(TensorAgentPlatform)' == 'ios' Or '$(TensorAgentPlatform)' == 'maccatalyst')">true</MtouchUseLlvm>

    <!-- NOT MtouchNoSymbolStrip. The engine is reached by dlsym through
         NativeLibrary.GetMainProgramHandle(), and Release strips the symbols back out
         after the link exports them:
             xcrun clang++ ... -Wl,-exported_symbol,_TSGgml_*      (exports them)
             xcrun strip -i -s <obj>/mtouch-symbols.list <exe>     (keeps ONLY that list)
         Turning the strip off with MtouchNoSymbolStrip=true DOES restore the exports
         (339/0 to 1730/248) and the engine comes up, but the executable grows from
         78 MB to 190 MB and the app then dies at startup: SIGABRT inside load_aot_module
         during mono_jit_init, before any managed code runs. MEASURED on device. So that
         is not the fix; the symbols are kept individually instead, through the
         ReferenceNativeSymbol item group the iOS SDK exposes. They live in
         GgmlExportedSymbols.targets, imported at the end of this file, which names
         every TSGgml_ export. A new native export has to be added there too:
         TensorAgentMauiProjectTests keeps that manifest equal to the TSG_EXPORT list
         in TensorSharp.GGML.Native, because an export missing from it survives Debug
         and the simulator and disappears only under the Release device strip, showing
         up as an EntryPointNotFound at runtime. -->

    <!-- Simulator bundles are ad-hoc signed ("-"); device builds need a real
         identity + profile passed on the command line (-p:CodesignKey=...). -->
    <CodesignKey Condition="$(RuntimeIdentifier.Contains('simulator'))">-</CodesignKey>

    <!-- The extension can be disabled for a build that intentionally wants the old
         app-only bundle. When enabled, its App Group is mandatory: custom URL schemes
         are neither private nor durable enough to carry user-shared content. -->
    <TensorAgentShareExtension Condition="'$(TensorAgentShareExtension)' == ''">true</TensorAgentShareExtension>

    <!-- The jetsam-budget entitlements are device-only: the simulator has no
         memory limit. CodesignEntitlements takes precedence over CustomEntitlements
         in the device build, so the sharing variant must carry the App Group itself;
         otherwise the build looks correct in XML but GetContainerUrl returns null on
         a phone. The app-only escape hatch keeps using the legacy profile. -->
    <CodesignEntitlements Condition="'$(RuntimeIdentifier)' == 'ios-arm64' AND '$(TensorAgentShareExtension)' == 'true'">Platforms/iOS/Entitlements.Share.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(RuntimeIdentifier)' == 'ios-arm64' AND '$(TensorAgentShareExtension)' != 'true'">Platforms/iOS/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup Condition="'$(TensorAgentShareExtension)' == 'true' And '$(TensorAgentPlatform)' == 'ios'">
    <CustomEntitlements Include="com.apple.security.application-groups"
                        Type="StringArray"
                        Value="group.ai.tensorsharp.tensoragent" />
  </ItemGroup>

  <ItemGroup Condition="'$(TensorAgentShareExtension)' == 'true' And '$(TensorAgentPlatform)' == 'ios'">
    <!-- IsAppExtension metadata makes the iOS SDK build and embed an .appex instead
         of treating this as a managed assembly reference. The extension needs its own
         provisioning profile on device; never pass the containing app's exact profile. -->
    <ProjectReference Include="../TensorAgent.ShareExtension/TensorAgent.ShareExtension.csproj">
      <IsAppExtension>true</IsAppExtension>
      <AdditionalProperties>CodesignProvision=$(TensorAgentShareProvision)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#0b1220" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0b1220" BaseSize="128,128" />

    <!-- The project banner at the top of the About page. It is the repository's own
         imgs/banner_1.png rather than a copy of it: the file is already 2 MB in git
         and a second one would drift from the first. A bitmap MauiImage with no
         BaseSize is copied into the bundle, not rescaled, so the app gets the single
         1253x836 original - more pixels than the ~1050 a 3x phone needs across the
         page's content width. -->
    <MauiImage Include="../../../imgs/banner_1.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(TensorAgentPlatform)' == 'ios' Or '$(TensorAgentPlatform)' == 'maccatalyst'">
    <!-- Keep each locale directory at the bundle root so Apple's permission dialogs
         can find its InfoPlist.strings, independently of MAUI's platform defaults. -->
    <BundleResource Remove="Platforms/iOS/Resources/**/InfoPlist.strings;Platforms/MacCatalyst/Resources/**/InfoPlist.strings" />
    <BundleResource Include="Platforms/iOS/Resources/**/InfoPlist.strings"
                    Condition="'$(TensorAgentPlatform)' == 'ios'"
                    LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <BundleResource Include="Platforms/MacCatalyst/Resources/**/InfoPlist.strings"
                    Condition="'$(TensorAgentPlatform)' == 'maccatalyst'"
                    LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The Web UI is TensorAgent's OWN page, not TensorSharp.Server's. The desktop
         page is laid out for a mouse, a wide window and an operator who started a
         server with arguments; this one is laid out for a thumb. Both talk to the
         same loopback API, so no capability is lost by not sharing a page. At runtime
         LoopbackWebHost serves this bundled page from <resources>/webui/. -->
    <BundleResource Include="wwwroot/**/*"
                    Link="webui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Services/Apple is the phone's and the Mac app's (UIKit, AVFoundation, QuickLook);
       Platforms/Windows carries Windows' own DeviceState, FilePresenter and Dictation. -->
  <ItemGroup Condition="'$(TensorAgentPlatform)' == 'windows'">
    <Compile Remove="Services/Apple/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TensorAgentPlatform)' == 'windows'">
    <!-- The same page beside the Windows executable. -->
    <Content Include="wwwroot/**/*"
             Link="webui/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TensorAgentPlatform)' == 'ios'">
    <!-- Static link of the whole engine: GgmlOps + ggml + ggml-cpu (+ ggml-metal
         with embedded shader source in the device slice). ForceLoad keeps every
         object file even though nothing in the app references the symbols
         directly (they are reached by dlsym through
         NativeLibrary.GetMainProgramHandle(), see GgmlNative.ImportResolver),
         and the exported_symbol flags keep the TSGgml_*/ggml_* symbols in the
         dynamic symbol table of the stripped executable so that dlsym can find
         them. -->
    <NativeReference Include="../../../TensorSharp.GGML.Native/build-ios/GgmlOps.xcframework"
                     Kind="Static"
                     ForceLoad="True"
                     SmartLink="False"
                     IsCxx="True"
                     Frameworks="Foundation Metal MetalKit MetalPerformanceShaders MetalPerformanceShadersGraph Accelerate"
                     LinkerFlags="-lc++ -Wl,-exported_symbol,_TSGgml_* -Wl,-exported_symbol,_ggml_*" />
  </ItemGroup>

  <ItemGroup>
    <!-- CPython 3.13, from BeeWare's Python-Apple-support build, linked as a dynamic
         framework and embedded in the bundle. It has to be a real link rather than a
         runtime dlopen: the interpreter's P/Invokes bind through
         NativeLibrary.GetMainProgramHandle(), which resolves against the main
         executable and everything already loaded with it.

         The slice is chosen by RuntimeIdentifier because the device and simulator
         builds are different binaries, and staged by scripts/prepare-python.sh, which
         must be run before an app build (the runtime is not in git). -->
    <NativeReference Condition="'$(RuntimeIdentifier)' == 'ios-arm64' AND Exists('../../python-runtime/device/Frameworks/Python.framework')"
                     Include="../../python-runtime/device/Frameworks/Python.framework"
                     Kind="Framework" />
    <NativeReference Condition="$(RuntimeIdentifier.Contains('simulator')) AND Exists('../../python-runtime/simulator/Frameworks/Python.framework')"
                     Include="../../python-runtime/simulator/Frameworks/Python.framework"
                     Kind="Framework" />
  </ItemGroup>

  <!-- CPython's compiled extension modules — binascii, _socket, _ssl, numpy's core,
       Pillow's imaging, 76 of them — cannot be plain files inside the bundle: iOS
       refuses to dlopen a Mach-O that is not in a signed framework, which is why
       Python-Apple-support ships each .so as its own framework and leaves a .fwork
       placeholder where the .so used to be. The placeholders are already staged with
       the standard library; without the frameworks beside them every `import binascii`
       fails at dlopen and most of the standard library goes with it.

       They are embedded rather than linked. Nothing references their symbols at build
       time — Python resolves them by dlopen at import — and force-loading 76 dylibs
       at launch would cost startup time for modules a given script never imports. -->
  <ItemGroup>
    <_TensorAgentPythonSlice Include="device" Condition="'$(RuntimeIdentifier)' == 'ios-arm64'" />
    <_TensorAgentPythonSlice Include="simulator" Condition="$(RuntimeIdentifier.Contains('simulator'))" />
  </ItemGroup>

  <Target Name="TensorAgentEmbedPythonExtensions"
          BeforeTargets="_CollectBundleResources;_CopyResourcesToBundle"
          Condition="'@(_TensorAgentPythonSlice)' != ''">
    <ItemGroup>
      <_TensorAgentPythonExtension
          Include="../../python-runtime/%(_TensorAgentPythonSlice.Identity)/Frameworks/**/*"
          Exclude="../../python-runtime/%(_TensorAgentPythonSlice.Identity)/Frameworks/Python.framework/**/*" />
      <BundleResource Include="@(_TensorAgentPythonExtension)"
                      Link="Frameworks/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <Message Importance="normal"
             Text="TensorAgent: embedding @(_TensorAgentPythonExtension->Count()) Python extension files" />
  </Target>

  <ItemGroup Condition="'$(TensorAgentPlatform)' == 'ios'">
    <!-- The skills that were verified to work inside this app, under
         <bundle>/skills/, which is one of the two roots the registry scans (the
         other is the writable directory the user installs into). The selection is
         not a judgement call in this file: scripts/verify-skills.py checks every
         Python script's imports against the staged interpreter, and every shell
         script for the Node package managers and bundlers the in-app shell does not
         have, and refuses anything that reaches for a process, a browser or a
         package that is not there; skills/verdicts.json records what it decided and
         why.

         TensorAgent/skills is also the skill directory the desktop hosts are pointed
         at (the server's skills-dir, the desktop TensorAgent host), so it holds
         skills the phone cannot run, and MSBuild cannot read the verdicts. Every
         skill directory without a passing verdict is therefore excluded by name
         below, and TensorAgentMauiProjectTests keeps that list equal to
         verdicts.json in both directions. Two fail today, both on shell scripts the
         verifier used to pass unexamined: playwright's only script execs npx to drive
         a Chromium, and web-artifacts-builder's two scripts install and run pnpm,
         npm and parcel. The app can start neither a Node package manager nor a
         browser, so bundled, either would be offered to the model and fail on its
         first step.

         Bytecode is excluded on purpose: running a skill's scripts on a
         development machine leaves __pycache__ beside them, and a .pyc compiled
         by a different CPython than the one in this bundle is either ignored or
         wrong. The interpreter compiles from source at run time instead. -->
    <BundleResource Include="../../skills/**/*"
                    Exclude="../../skills/verdicts.json;../../skills/**/__pycache__/**/*;../../skills/playwright/**/*;../../skills/web-artifacts-builder/**/*"
                    Link="skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The desktop heads ship every skill. They run a skill's scripts the way the desktop
       hosts do, as real python3, node, npm and browser processes, so the verdicts above
       (which are about what the phone's in-app interpreters can run) do not apply:
       playwright and web-artifacts-builder are exactly the skills a desktop is for.
       Bytecode and installed node_modules are what running a skill on a development
       machine leaves behind, never part of the skill. -->
  <ItemGroup Condition="'$(TensorAgentPlatform)' == 'maccatalyst'">
    <BundleResource Include="../../skills/**/*"
                    Exclude="../../skills/verdicts.json;../../skills/**/__pycache__/**/*;../../skills/**/node_modules/**/*"
                    Link="skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TensorAgentPlatform)' == 'windows'">
    <Content Include="../../skills/**/*"
             Exclude="../../skills/verdicts.json;../../skills/**/__pycache__/**/*;../../skills/**/node_modules/**/*"
             Link="skills/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The desktop engine: the same GgmlOps library the desktop hosts load, built by the
       GGML backend project's own incremental native build (build-macos.sh or
       build-windows.ps1) and shipped beside the app, where GgmlNative's resolver finds
       it. The referenced projects skip their native builds (TensorSharpSkipGgmlNative
       above), so this target is the one place it runs for this project. It reuses the
       backend project's stamps, so an up-to-date library costs nothing, and a native
       source newer than the library rebuilds it before the app is assembled: an app
       shipped around a stale library fails at its first missing export. -->
  <PropertyGroup>
    <TensorAgentGgmlNativeDir>$(MSBuildThisFileDirectory)../../../TensorSharp.GGML.Native/build</TensorAgentGgmlNativeDir>
    <TensorAgentGgmlNativeDir Condition="$([MSBuild]::IsOSPlatform('windows'))">$(MSBuildThisFileDirectory)../../../TensorSharp.GGML.Native/build-windows</TensorAgentGgmlNativeDir>
  </PropertyGroup>

  <Target Name="TensorAgentBuildDesktopEngine" BeforeTargets="BeforeBuild"
          Condition="'$(TensorAgentPlatform)' == 'maccatalyst' Or '$(TensorAgentPlatform)' == 'windows'">
    <MSBuild Projects="../../../TensorSharp.Backends.GGML/TensorSharp.Backends.GGML.csproj"
             Targets="BuildGgmlNativeUnix;BuildGgmlNativeWindows"
             Properties="TensorSharpSkipGgmlNative=false"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;TensorSharpAppleTargets" />
  </Target>

  <!-- LTX uses the owned direct MLX executor on the Mac. Build a missing runtime
       and bundle its libraries and Metal kernels together for portable installs. -->
  <Target Name="TensorAgentBuildMlxDesktopEngine" BeforeTargets="BeforeBuild"
          Condition="'$(TensorAgentPlatform)' == 'maccatalyst'">
    <MSBuild Projects="../../../TensorSharp.Backends.MLX/TensorSharp.Backends.MLX.csproj"
             Targets="BuildMlxNative"
             Properties="TensorSharpSkipMlxNative=false;TENSORSHARP_MLX_NATIVE_SKIP=false"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;TensorSharpAppleTargets" />
  </Target>

  <ItemGroup Condition="'$(TensorAgentPlatform)' == 'maccatalyst'">
    <!-- Binary distributions retain the engine's license and third-party notices
         inside the app, including the ZIP/PKG variants without a readme beside it. -->
    <BundleResource Include="../../../LICENSE" Link="licenses/TensorSharp.txt" />
    <BundleResource Include="../../../ExternalProjects/ggml/LICENSE" Link="licenses/ggml.txt"
                    Condition="Exists('../../../ExternalProjects/ggml/LICENSE')" />
    <BundleResource Include="../../../TensorSharp.Chat/Jev/Apache-2.0.txt;../../../TensorSharp.Chat/Jev/NOTICE.md"
                    Link="licenses/Jev/%(Filename)%(Extension)" />
    <!-- A dynamic NativeReference: the SDK copies it into Contents/MonoBundle beside the
         managed assemblies, rewrites its install name for that location and signs it
         with the app. -->
    <NativeReference Include="$(TensorAgentGgmlNativeDir)/libGgmlOps.dylib" Kind="Dynamic" />
    <NativeReference Include="../../../TensorSharp.Backends.MLX/Native/dist/libmlxc.dylib" Kind="Dynamic" />
    <NativeReference Include="../../../TensorSharp.Backends.MLX/Native/dist/libmlx.dylib" Kind="Dynamic" />
    <NativeReference Include="../../../TensorSharp.Backends.MLX/Native/dist/libjaccl.dylib" Kind="Dynamic" />
    <Content Include="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../TensorSharp.Backends.MLX/Native/dist/lib/mlx.metallib'))"
             Link="mlx.metallib" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" PublishFolderType="Assembly" />
  </ItemGroup>

  <Target Name="TensorAgentShipWindowsEngine" AfterTargets="TensorAgentBuildDesktopEngine"
          Condition="'$(TensorAgentPlatform)' == 'windows'">
    <ItemGroup>
      <_TensorAgentWindowsEngine Include="$(TensorAgentGgmlNativeDir)/Release/GgmlOps.dll"
                                 Condition="Exists('$(TensorAgentGgmlNativeDir)/Release/GgmlOps.dll')" />
      <_TensorAgentWindowsEngine Include="$(TensorAgentGgmlNativeDir)/GgmlOps.dll"
                                 Condition="'@(_TensorAgentWindowsEngine)' == '' And Exists('$(TensorAgentGgmlNativeDir)/GgmlOps.dll')" />
      <Content Include="@(_TensorAgentWindowsEngine)" Link="GgmlOps.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(_TensorAgentWindowsEngine)' == ''"
           Text="TensorAgent: no GgmlOps.dll under $(TensorAgentGgmlNativeDir) after the native build; see TensorSharp.GGML.Native/build-windows.ps1." />
  </Target>

  <ItemGroup>
    <!-- The standard library and the pure-Python packages, verbatim, under
         <bundle>/python/. EmbeddedPython points PyConfig.module_search_paths here. -->
    <BundleResource Condition="'$(RuntimeIdentifier)' == 'ios-arm64'"
                    Include="../../python-runtime/device/python/**/*"
                    Link="python/%(RecursiveDir)%(Filename)%(Extension)" />
    <BundleResource Condition="$(RuntimeIdentifier.Contains('simulator'))"
                    Include="../../python-runtime/simulator/python/**/*"
                    Link="python/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../TensorSharp.Core/TensorSharp.Core.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
    <ProjectReference Include="../../../TensorSharp.Runtime/TensorSharp.Runtime.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
    <ProjectReference Include="../../../TensorSharp.Runtime.Logging/TensorSharp.Runtime.Logging.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
    <ProjectReference Include="../../../TensorSharp.Models/TensorSharp.Models.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
    <ProjectReference Include="../../../TensorSharp.Backends.GGML/TensorSharp.Backends.GGML.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
    <ProjectReference Include="../../../TensorSharp.AgentHost/TensorSharp.AgentHost.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
    <ProjectReference Include="../../../TensorSharp.Chat/TensorSharp.Chat.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
    <ProjectReference Include="../TensorAgent.Core/TensorAgent.Core.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
    <ProjectReference Include="../TensorAgent.Sharing/TensorAgent.Sharing.csproj" AdditionalProperties="$(TensorSharpNativeSkipProperties)" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="TensorSharp.Core" />
    <TrimmerRootAssembly Include="TensorSharp.Runtime" />
    <TrimmerRootAssembly Include="TensorSharp.Runtime.Logging" />
    <TrimmerRootAssembly Include="TensorSharp.Models" />
    <TrimmerRootAssembly Include="TensorSharp.Backends.GGML" />
    <TrimmerRootAssembly Include="TensorSharp.AgentHost" />
    <TrimmerRootAssembly Include="TensorSharp.Chat" />
    <TrimmerRootAssembly Include="TensorSharp.Knowledge" />
    <TrimmerRootAssembly Include="TensorAgent.Core" />
    <TrimmerRootAssembly Include="TensorAgent.Sharing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- The only place a phone can log to is stdout, which the simulator's launch
         console shows and a device log capture picks up. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.6" />
  </ItemGroup>

  <!-- The phone's Release strip list; the desktop heads load the engine as a library. -->
  <Import Project="GgmlExportedSymbols.targets" Condition="'$(TensorAgentPlatform)' == 'ios'" />
  <!-- The embedded CPython entry points the Mac app does not link; see the file. -->
  <Import Project="EmbeddedPythonSymbols.targets" Condition="'$(TensorAgentPlatform)' == 'maccatalyst'" />
  <!-- An Xcode a minor release ahead of the Apple SDK builds with a warning; see the file. -->
  <Import Project="XcodeVersion.targets" Condition="'$(TensorAgentPlatform)' == 'ios' Or '$(TensorAgentPlatform)' == 'maccatalyst'" />

</Project>

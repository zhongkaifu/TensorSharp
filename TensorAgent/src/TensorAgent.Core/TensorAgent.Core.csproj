<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>TensorAgent.Core</RootNamespace>
    <Description>Platform-neutral core of the TensorAgent iOS app: model catalog and store, resumable downloads, conversation persistence, settings, and the in-process execution runtimes.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Served by LoopbackServer and appended to index.html at request time, so the
         Server's page stays unforked. Embedded rather than copied to disk because the
         script and the routes it calls have to ship as one thing. -->
    <EmbeddedResource Include="WebUi\tensoragent.js" />
    <!-- The interface's strings, one directory per language (Localization/<tag>/<area>.json),
         read by Loc under "TensorAgent.Core.Localization.<tag>/" and served to the page with
         the runtime that reads them as /i18n.js (PageStrings). -->
    <EmbeddedResource Include="WebUi\i18n.js" />
    <EmbeddedResource Include="Localization\**\*.json"
                      LogicalName="TensorAgent.Core.Localization.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\TensorSharp.Chat\WebUi\studio.js" LogicalName="TensorAgent.Core.WebUi.studio.js" />
    <EmbeddedResource Include="..\..\..\TensorSharp.Chat\WebUi\studio.css" LogicalName="TensorAgent.Core.WebUi.studio.css" />
    <EmbeddedResource Include="..\..\..\TensorSharp.Chat\WebUi\mask-editor.js" LogicalName="TensorAgent.Core.WebUi.mask-editor.js" />
    <EmbeddedResource Include="..\..\..\TensorSharp.Chat\WebUi\mask-editor.css" LogicalName="TensorAgent.Core.WebUi.mask-editor.css" />
    <!-- The engine's own LoRA plug-in configs. A speed plug-in whose weights do not carry
         their sampling schedule is handed its config with them (LoraCatalog.RecipeConfig,
         LoraStore.SpecFor); embedding the repository's files keeps the app on the same
         schedules the CLI and server use, and LoraCatalogTests keeps the catalog equal to them. -->
    <EmbeddedResource Include="..\..\..\config\lora\*.json" LogicalName="lora/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TensorAgent.Tests" />
    <InternalsVisibleTo Include="TensorAgent.Maui" />
  </ItemGroup>
  <ItemGroup>
    <!-- Small, dependency-free wire contract shared with the iOS share extension. -->
    <ProjectReference Include="..\TensorAgent.Sharing\TensorAgent.Sharing.csproj" />
    <ProjectReference Include="..\..\..\TensorSharp.Runtime\TensorSharp.Runtime.csproj" />
    <ProjectReference Include="..\..\..\TensorSharp.AgentHost\TensorSharp.AgentHost.csproj" />
    <ProjectReference Include="..\..\..\TensorSharp.Chat\TensorSharp.Chat.csproj" />
    <ProjectReference Include="..\..\..\TensorSharp.Models\TensorSharp.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
  </ItemGroup>
</Project>

#
# Embeds the TensorSharp Metal (tsm) kernel sources into one C++ raw string, the way the runtime compiles them
# (newLibraryWithSource): <metal_stdlib>, then the unmodified upstream ggml-common.h (its i-quant grids and block
# structs), then each kernel file. Run as a script: cmake -DOUT=<inc> -DGGML_COMMON=<header> -DFILES=<a;b;...> -P this.
# -DVAR=<name> names the string (default kTsmMoeSource); -DMPP=1 prepends the Metal 4 tensor API (MetalPerformancePrimitives)
# instead of ggml-common.h, for a library compiled on its own at language 4.0.
if (NOT VAR)
    set(VAR kTsmMoeSource)
endif()
set(content "// Generated by tsm/tsm_embed.cmake from tsm/kernels/*.metal; do not edit.\n")
string(APPEND content "static const char* const ${VAR} = R\"TSMSL(")
if (MPP)
    string(APPEND content "#include <metal_stdlib>\n#include <metal_tensor>\n#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>\nusing namespace metal;\nusing namespace mpp::tensor_ops;\n")
else()
    string(APPEND content "#include <metal_stdlib>\nusing namespace metal;\n#define GGML_COMMON_DECL_METAL\n#define GGML_COMMON_IMPL_METAL\n")
    file(READ "${GGML_COMMON}" ggml_common)
    string(APPEND content "${ggml_common}\n")
endif()
foreach(f IN LISTS FILES)
    file(READ "${f}" src)
    get_filename_component(name "${f}" NAME)
    string(APPEND content "#line 1 \"${name}\"\n${src}\n")
endforeach()
string(APPEND content ")TSMSL\";\n")
file(WRITE "${OUT}.tmp" "${content}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")

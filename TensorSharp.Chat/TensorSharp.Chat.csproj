<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>BSD-3-Clause AND Apache-2.0</PackageLicenseExpression>
    <Nullable>annotations</Nullable>
    <Description>Host-neutral chat pipeline for TensorSharp: model service, sessions, generation, skills loop and the Web UI request/stream contract, independent of ASP.NET Core</Description>
    <PackageTags>$(TensorSharpPackageTags);chat;sessions;skills;webui;pipeline</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The chat stack kept the Server's `internal` visibility when it moved out, so the
         hosts that compose it see the same surface the Server always did. -->
    <InternalsVisibleTo Include="TensorSharp.Server" />
    <InternalsVisibleTo Include="TensorSharp.Cli" />
    <InternalsVisibleTo Include="InferenceWeb.Tests" />
    <InternalsVisibleTo Include="TensorAgent.Core" />
    <InternalsVisibleTo Include="TensorAgent.Tests" />
    <InternalsVisibleTo Include="TensorAgent.Maui" />
  </ItemGroup>
  <ItemGroup>
    <!-- Deliberately NOT referenced: TensorSharp.Distributed (it references
         TensorSharp.Backends.Cuda, so a net10.0-ios consumer could never link it;
         multi-node tensor parallelism is handed in through
         ModelService.TensorParallelGroupFactory by the Server and CLI hosts instead),
         and Backends.Cuda / Backends.MLX directly (Models already carries them; the
         backend probes that touch them live in the Server's BackendCatalogProbes).
         ChatLayeringTests fails the moment either shows up in this assembly's
         references. -->
    <ProjectReference Include="..\TensorSharp.Studio\TensorSharp.Studio.csproj" />
    <ProjectReference Include="..\TensorSharp.Runtime.Logging\TensorSharp.Runtime.Logging.csproj" />
    <ProjectReference Include="..\TensorSharp.Runtime\TensorSharp.Runtime.csproj" />
    <ProjectReference Include="..\TensorSharp.AgentHost\TensorSharp.AgentHost.csproj" />
    <ProjectReference Include="..\TensorSharp.Knowledge\TensorSharp.Knowledge.csproj" />
    <ProjectReference Include="..\TensorSharp.Models\TensorSharp.Models.csproj" />
    <ProjectReference Include="..\TensorSharp.Backends.GGML\TensorSharp.Backends.GGML.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Knowledge/OcrAssets/manifest.json;Knowledge/OcrAssets/NOTICE.md;Knowledge/OcrAssets/package-notices.json" />
    <None Update="Knowledge/OcrAssets/NOTICE.md;Knowledge/OcrAssets/package-notices.json" Pack="true" PackagePath="licenses/pdf-ocr/" />
    <None Update="Jev/NOTICE.md;Jev/Apache-2.0.txt"
          Pack="true" PackagePath="licenses/jev/"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

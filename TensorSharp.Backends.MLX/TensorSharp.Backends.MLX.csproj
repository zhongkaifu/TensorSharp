<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <IsPackable>true</IsPackable>
    <Nullable>disable</Nullable>
    <Description>Native MLX backend for TensorSharp inference on Apple Silicon / Metal.</Description>
    <PackageTags>$(TensorSharpPackageTags);mlx;metal;apple-silicon;gpu</PackageTags>
  </PropertyGroup>
  <PropertyGroup>
    <MlxNativeSourceDir>$(MSBuildProjectDirectory)/Native</MlxNativeSourceDir>
    <MlxNativeInstallDir>$(MlxNativeSourceDir)/dist</MlxNativeInstallDir>
    <MlxNativeBuildScript Condition="$([MSBuild]::IsOSPlatform('OSX'))">build-native-macos.sh</MlxNativeBuildScript>
    <MlxNativeBinaryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmlxc.dylib</MlxNativeBinaryName>
    <MlxNativeDependencyName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmlx.dylib</MlxNativeDependencyName>
    <MlxNativeJacclName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libjaccl.dylib</MlxNativeJacclName>
    <!-- MLX's precompiled Metal kernels. mlx loads this via dladdr on its own
         code (mlx/backend/common/utils.cpp: current_binary_dir), so it must sit
         in the SAME directory as libmlx.dylib. Its only other fallback is a
         METAL_PATH baked in at compile time that points into the build tree,
         which does not exist on a machine that just consumes the binaries. -->
    <MlxNativeMetallibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">mlx.metallib</MlxNativeMetallibName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TensorSharp.Core\TensorSharp.Core.csproj" />
    <ProjectReference Include="..\TensorSharp.Runtime\TensorSharp.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InferenceWeb.Tests" />
  </ItemGroup>
  <Target Name="BuildMlxNative"
          BeforeTargets="BeforeBuild"
          Condition="'$(MlxNativeBuildScript)' != '' And '$(TensorSharpSkipMlxNative)' != 'true' And '$(TENSORSHARP_MLX_NATIVE_SKIP)' != 'true' And '$(TargetPlatformIdentifier)' != 'ios' And ('$(TensorSharpBuildMlxNative)' == 'true' Or '$(TENSORSHARP_MLX_NATIVE_BUILD)' == 'true' Or !Exists('$(MlxNativeInstallDir)/$(MlxNativeBinaryName)'))">
    <Message Importance="high" Text="Building MLX native library via $(MlxNativeBuildScript) (this may take several minutes on first build; set TENSORSHARP_MLX_NATIVE_SKIP=true to skip)..." />
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/$(MlxNativeBuildScript)&quot;" />
  </Target>
  <!-- MLX is a macOS-only backend; an iOS build must never shell out to the
       macOS native build script (nor copy its dylibs into the app bundle). -->
  <Target Name="CopyMlxNativeBinary" AfterTargets="Build" Condition="'$(MlxNativeBinaryName)' != '' And '$(TargetPlatformIdentifier)' != 'ios'">
    <ItemGroup>
      <MlxNativeBinary Include="$(MlxNativeInstallDir)/$(MlxNativeBinaryName)" Condition="Exists('$(MlxNativeInstallDir)/$(MlxNativeBinaryName)')" />
      <MlxNativeBinary Include="$(MlxNativeInstallDir)/$(MlxNativeDependencyName)" Condition="'$(MlxNativeDependencyName)' != '' And Exists('$(MlxNativeInstallDir)/$(MlxNativeDependencyName)')" />
      <MlxNativeBinary Include="$(MlxNativeInstallDir)/$(MlxNativeJacclName)" Condition="'$(MlxNativeJacclName)' != '' And Exists('$(MlxNativeInstallDir)/$(MlxNativeJacclName)')" />
      <MlxNativeBinary Include="$(MlxNativeInstallDir)/lib/$(MlxNativeJacclName)" Condition="'$(MlxNativeJacclName)' != '' And Exists('$(MlxNativeInstallDir)/lib/$(MlxNativeJacclName)')" />
      <!-- cmake installs the metallib under lib/ only, but prefer a root-level
           copy if a future layout puts one there. Unlike the dylibs above these
           two are mutually exclusive: the metallib is ~150 MB, so copying the
           same file twice into the same destination is worth avoiding. -->
      <MlxNativeBinary Include="$(MlxNativeInstallDir)/$(MlxNativeMetallibName)" Condition="'$(MlxNativeMetallibName)' != '' And Exists('$(MlxNativeInstallDir)/$(MlxNativeMetallibName)')" />
      <MlxNativeBinary Include="$(MlxNativeInstallDir)/lib/$(MlxNativeMetallibName)" Condition="'$(MlxNativeMetallibName)' != '' And !Exists('$(MlxNativeInstallDir)/$(MlxNativeMetallibName)') And Exists('$(MlxNativeInstallDir)/lib/$(MlxNativeMetallibName)')" />
    </ItemGroup>
    <Copy SourceFiles="@(MlxNativeBinary)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>

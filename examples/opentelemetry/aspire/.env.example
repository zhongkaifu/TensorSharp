#
# Copy this file to .env in the same directory and replace both values with random keys of at
# least 128 bits. .env is git-ignored here; do not commit it.
#
#   bash:          openssl rand -hex 32
#   PowerShell 7:  [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#
# Use two different keys: the OTLP key goes into every TensorSharp process you point at the
# dashboard, the API key only into the tools that read telemetry back.

# Required on every OTLP export as the header x-otlp-api-key. TensorSharp sends it with
#   OTEL_EXPORTER_OTLP_HEADERS=x-otlp-api-key=<this value>
ASPIRE_OTLP_API_KEY=replace-with-a-random-key

# Required on every telemetry API request (GET /api/telemetry/*) as the header x-api-key.
ASPIRE_API_KEY=replace-with-a-different-random-key

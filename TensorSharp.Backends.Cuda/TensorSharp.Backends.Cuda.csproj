<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <IsPackable>true</IsPackable>
    <Nullable>disable</Nullable>
    <Description>Direct CUDA backend for TensorSharp using the CUDA Driver API, cuBLAS, PTX kernels, and quantized CUDA ops.</Description>
    <PackageTags>$(TensorSharpPackageTags);backend;cuda;cublas;gpu;ptx</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TensorSharp.Core\TensorSharp.Core.csproj" />
    <ProjectReference Include="..\TensorSharp.Memory\TensorSharp.Memory.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CudaKernelDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'native', 'kernels'))</CudaKernelDir>
    <!-- Committed PTX baseline, used when nvcc is unavailable. nvcc output goes to
         the intermediate directory below so that building never modifies files
         tracked in git (see discussion #130); refresh the committed baseline
         explicitly with `dotnet build -p:TensorSharpUpdateCommittedPtx=true`
         after editing a kernel, and commit the resulting diff. -->
    <CudaCommittedPtxDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'native', 'ptx'))</CudaCommittedPtxDir>
    <PtxOutputDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'obj', 'cuda_ptx', 'ptx'))</PtxOutputDir>
    <CudaPtxStampDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'obj', 'cuda_ptx'))</CudaPtxStampDir>
    <CudaArchResolverPs1>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'native', 'resolve-cuda-arch.ps1'))</CudaArchResolverPs1>
    <CudaArchResolverSh>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'native', 'resolve-cuda-arch.sh'))</CudaArchResolverSh>
    <CudaArch Condition="'$(CudaArch)' == '' And '$(TENSORSHARP_CUDA_ARCH)' != ''">$(TENSORSHARP_CUDA_ARCH)</CudaArch>
    <CudaArch Condition="'$(CudaArch)' == ''">auto</CudaArch>
    <CudaArchFallback Condition="'$(CudaArchFallback)' == ''">compute_61</CudaArchFallback>
    <CudaNvccOptimizationFlags Condition="'$(CudaNvccOptimizationFlags)' == ''">-O3 --extra-device-vectorization</CudaNvccOptimizationFlags>
    <CudaEnableFastMath Condition="'$(CudaEnableFastMath)' == ''">false</CudaEnableFastMath>
    <CudaFastMathFlag Condition="'$(CudaEnableFastMath)' == 'true' Or '$(CudaEnableFastMath)' == 'True'">--use_fast_math</CudaFastMathFlag>
  </PropertyGroup>

  <ItemGroup>
    <CudaKernel Include="$(CudaKernelDir)/*.cu">
      <FastMathFlag></FastMathFlag>
    </CudaKernel>
    <!-- Headers the kernels #include (e.g. the vendored IQ2_XXS tables). Tracked as
         build inputs so editing them re-triggers the PTX compile below. -->
    <CudaKernelHeader Include="$(CudaKernelDir)/*.cuh" />
    <!-- The committed PTX baseline flows to this project's output, to referencing
         projects and to publish layouts as cuda_kernels/*.ptx. On machines with
         nvcc, SelectCudaPtxContent below swaps these for the locally compiled
         PTX before target paths are assigned. -->
    <Content Include="$(CudaCommittedPtxDir)/*.ptx" Link="cuda_kernels\%(Filename)%(Extension)" Condition="Exists('$(CudaCommittedPtxDir)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ResolveCudaPtxBuildSettings">
    <Exec Command="nvcc --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_NvccExitCode" />
    </Exec>
    <Exec Condition="'$(_NvccExitCode)' == '0' And ('$(CudaArch)' == 'auto' Or '$(CudaArch)' == 'native') And '$([MSBuild]::IsOSPlatform(Windows))' == 'true'"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(CudaArchResolverPs1)&quot; -FallbackArch &quot;$(CudaArchFallback)&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DetectedCudaArch" />
      <Output TaskParameter="ExitCode" PropertyName="_DetectCudaArchExitCode" />
    </Exec>
    <Exec Condition="'$(_NvccExitCode)' == '0' And ('$(CudaArch)' == 'auto' Or '$(CudaArch)' == 'native') And '$([MSBuild]::IsOSPlatform(Windows))' != 'true'"
          Command="sh &quot;$(CudaArchResolverSh)&quot; &quot;$(CudaArchFallback)&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DetectedCudaArch" />
      <Output TaskParameter="ExitCode" PropertyName="_DetectCudaArchExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_NvccExitCode)' == '0'">
      <_ResolvedCudaArch Condition="'$(CudaArch)' != 'auto' And '$(CudaArch)' != 'native'">$(CudaArch)</_ResolvedCudaArch>
      <_ResolvedCudaArch Condition="'$(_ResolvedCudaArch)' == '' And '$(_DetectCudaArchExitCode)' == '0' And '$(_DetectedCudaArch)' != ''">$(_DetectedCudaArch.Trim())</_ResolvedCudaArch>
      <_ResolvedCudaArch Condition="'$(_ResolvedCudaArch)' == ''">$(CudaArchFallback)</_ResolvedCudaArch>
      <_CudaBuildSettingsKey>$(_ResolvedCudaArch.Replace('compute_', 'compute_').Replace('sm_', 'sm_'))_$(CudaNvccOptimizationFlags.Replace(' ', '_').Replace('-', ''))$(CudaFastMathFlag.Replace(' ', '_').Replace('-', ''))</_CudaBuildSettingsKey>
    </PropertyGroup>
    <Message Condition="'$(_NvccExitCode)' == '0' And ('$(CudaArch)' == 'auto' Or '$(CudaArch)' == 'native') And '$(_DetectCudaArchExitCode)' != '' And '$(_DetectCudaArchExitCode)' != '0'"
             Importance="high"
             Text="WARNING: TensorSharp CUDA architecture detection failed; using $(CudaArchFallback)." />
    <Message Condition="'$(_NvccExitCode)' == '0'" Importance="high" Text="TensorSharp CUDA build: PTX target is $(_ResolvedCudaArch)" />
  </Target>

  <!-- When nvcc is available, replace the committed PTX Content items with the
       locally compiled ones from the intermediate directory, so this project's
       output, referencing projects and publish layouts all receive PTX that
       matches the local kernel sources and GPU. Hooked before AssignTargetPaths
       so the swapped items flow through GetCopyToOutputDirectoryItems to
       consumers; skipped for IDE design-time builds, which should not probe
       nvcc. CompileCudaPtx (BeforeTargets=BeforeBuild) has produced the files
       by the time anything copies them. -->
  <Target Name="SelectCudaPtxContent"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveCudaPtxBuildSettings"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup Condition="'$(_NvccExitCode)' == '0'">
      <Content Remove="$(CudaCommittedPtxDir)/*.ptx" />
      <Content Include="@(CudaKernel->'$(PtxOutputDir)/%(Filename).ptx')">
        <Link>cuda_kernels\%(Filename).ptx</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <!-- The CUDA kernels are self-contained: the only data they needed from ggml
       (the IQ2_XXS dequant lookup tables) is vendored in
       native/kernels/tensorsharp_iq2xxs_tables.cuh, so this backend builds without
       the upstream ggml checkout (ExternalProjects/ggml) or any ggml fetch step. -->
  <Target Name="CompileCudaPtx"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="ResolveCudaPtxBuildSettings"
          Inputs="@(CudaKernel);@(CudaKernelHeader);$(MSBuildProjectFullPath);$(CudaArchResolverPs1);$(CudaArchResolverSh)"
          Outputs="@(CudaKernel->'$(PtxOutputDir)/%(Filename).ptx');$(CudaPtxStampDir)/tensorsharp_cuda_$(_CudaBuildSettingsKey).stamp">
    <Message Condition="'$(_NvccExitCode)' != '0'" Importance="high"
             Text="TensorSharp CUDA build: nvcc not found; using the committed PTX kernels." />
    <PropertyGroup Condition="'$(_NvccExitCode)' == '0' And '$([MSBuild]::IsOSPlatform(Windows))' == 'true' And '$(VCToolsInstallDir)' != ''">
      <_CompilerBinDir>--compiler-bindir="$(VCToolsInstallDir)bin\Hostx64\x64"</_CompilerBinDir>
    </PropertyGroup>
    <!-- The query below asks vswhere for "all, including prerelease" rather than
         "latest": the VS installer flags an instance "incomplete" after an
         interrupted update, and a latest-only query silently skips such instances
         (prints nothing, exits 0) even though cl.exe on disk works fine. nvcc
         would then run with no host compiler directory and fail with
         "Cannot find compiler 'cl.exe' in PATH". Same reasoning as
         eng/vs-locate.ps1. -->
    <Exec Condition="'$(_NvccExitCode)' == '0' And '$([MSBuild]::IsOSPlatform(Windows))' == 'true' And '$(_CompilerBinDir)' == ''"
          Command="for /f &quot;delims=&quot; %%i in ('&quot;%25ProgramFiles(x86)%25\Microsoft Visual Studio\Installer\vswhere.exe&quot; -all -prerelease -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find VC\Tools\MSVC\**\bin\Hostx64\x64\cl.exe') do @echo %%~dpi"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ClExeDir" />
    </Exec>
    <PropertyGroup Condition="'$(_CompilerBinDir)' == '' And '$(_ClExeDir)' != ''">
      <!-- vswhere prints one line per installed MSVC toolset and Exec joins them
           with ';', which nvcc would reject as a single bogus compiler-bindir
           path. Keep only the first (oldest) toolset: nvcc caps the host cl
           version it accepts, so the oldest installed toolset is the safest. -->
      <_ClExeDirClean>$(_ClExeDir.Split(';')[0].Trim().TrimEnd('\'))</_ClExeDirClean>
      <_CompilerBinDir>--compiler-bindir=&quot;$(_ClExeDirClean)&quot;</_CompilerBinDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_NvccExitCode)' == '0' And '$(_CompilerBinDir)' != ''">
      <!-- MSVC 14.5x toolsets (VS 2026) are newer than the host-compiler range
           current CUDA toolkits accept, so nvcc aborts in host_config.h with
           "unsupported Microsoft Visual Studio version!". Let it proceed; the
           flag is a no-op once the installed CUDA toolkit officially supports
           the toolset. -->
      <_NvccAllowUnsupportedCompilerFlag Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_CompilerBinDir)', 'MSVC\\14\.[5-9][0-9]'))">-allow-unsupported-compiler</_NvccAllowUnsupportedCompilerFlag>
    </PropertyGroup>
    <MakeDir Condition="'$(_NvccExitCode)' == '0'" Directories="$(PtxOutputDir);$(CudaPtxStampDir)" />
    <Message Condition="'$(_NvccExitCode)' == '0'" Importance="high" Text="Compiling %(CudaKernel.Filename).cu to PTX for $(_ResolvedCudaArch)" />
    <Exec Condition="'$(_NvccExitCode)' == '0'"
          Command="nvcc -ptx -arch=$(_ResolvedCudaArch) $(CudaNvccOptimizationFlags) $(CudaFastMathFlag) %(CudaKernel.FastMathFlag) $(_CompilerBinDir) $(_NvccAllowUnsupportedCompilerFlag) -o &quot;$(PtxOutputDir)/%(CudaKernel.Filename).ptx&quot; &quot;%(CudaKernel.FullPath)&quot;"
          StandardOutputImportance="low" />
    <WriteLinesToFile Condition="'$(_NvccExitCode)' == '0'"
                      File="$(CudaPtxStampDir)/tensorsharp_cuda_$(_CudaBuildSettingsKey).stamp"
                      Lines="arch=$(_ResolvedCudaArch);flags=$(CudaNvccOptimizationFlags) $(CudaFastMathFlag)"
                      Overwrite="true" />
  </Target>

  <Target Name="CopyCudaPtxToOutput" AfterTargets="CompileCudaPtx">
    <ItemGroup>
      <_CompiledPtx Include="$(PtxOutputDir)/*.ptx" />
    </ItemGroup>
    <MakeDir Directories="$([MSBuild]::NormalizePath('$(OutDir)', 'cuda_kernels'))" Condition="'@(_CompiledPtx)' != ''" />
    <Copy SourceFiles="@(_CompiledPtx)"
          DestinationFolder="$([MSBuild]::NormalizePath('$(OutDir)', 'cuda_kernels'))"
          SkipUnchangedFiles="true"
          Condition="'@(_CompiledPtx)' != ''" />
  </Target>

  <!-- Explicit opt-in that copies the freshly compiled PTX over the committed
       baseline in native/ptx:
         dotnet build TensorSharp.Backends.Cuda -p:TensorSharpUpdateCommittedPtx=true
       Run this after editing a .cu kernel and commit the resulting diff -
       machines without nvcc run the committed PTX, so a kernel change that is
       not regenerated here ships silently-stale kernels to them. Keep the
       committed baseline's architecture stable (see DEVELOPMENT.md) so diffs
       reflect real kernel changes. -->
  <Target Name="UpdateCommittedCudaPtx"
          AfterTargets="CompileCudaPtx"
          Condition="'$(TensorSharpUpdateCommittedPtx)' == 'true' And '$(_NvccExitCode)' == '0'">
    <Copy SourceFiles="@(CudaKernel->'$(PtxOutputDir)/%(Filename).ptx')"
          DestinationFolder="$(CudaCommittedPtxDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Updated committed PTX baseline in $(CudaCommittedPtxDir) (arch $(_ResolvedCudaArch)); review and commit the diff." />
  </Target>
</Project>

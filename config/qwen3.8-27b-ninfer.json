{
  // Shared CLI/Server.Host profile for the NInfer v3 Qwen3.8-27B artifact. Add --chat only for the interactive CLI.
  // The artifact embeds its tokenizer, chat template and DFlash2 companion weights.
  //
  // Qwen3.8-27B's fastest measured setup on NVIDIA: the NVFP4 artifact on the direct CUDA engine with its DFlash2
  // weights (7 drafts, no confidence gate). RTX 5090, 2026-11-05 campaign: decode ~203 tok/s single stream (73 without
  // drafting), 8K-token TTFT 0.78 s, four requests at once up to 372 tok/s in all. The UD-IQ3_XXS GGUF with the
  // DFlash2 GGUF on ggml_cuda (2026-11-09, d4f33229, after 74310bb0's VRAM fix) decodes 155-178 tok/s single stream
  // and 168-192 tok/s for four requests at once. For long-prompt work there, Tencent's DSpine drafter with 15 drafts
  // and a 0.35 gate decodes 416-431 tok/s after a 4K-token prompt (DFlash2 140-251) and 233-252 after 16K
  // (DFlash2 170-189); DFlash2 stays ahead on free generation. See docs/speculative_decoding.md#dspine. That setup is
  // config/qwen3.8-27b-cuda-dflash2.json, the preset for NVIDIA GPUs other than sm_120: this artifact's kernels need it.
  // Apple Silicon: config/qwen3.8-27b-metal-dflash2.json (ggml-metal has no NVFP4 matmul).
  "variables": { "modelRoot": "${TENSORSHARP_MODELS:-../models}" },
  "model": {
    "path": "${modelRoot}/qwen3_8_27b_nvfp4.ninfer",
    "urls": ["https://huggingface.co/neroued/Qwen3.8-27B-nvfp4-NInfer/resolve/0190293051af2c578f2f3d5264cf2bcd9af051c2/qwen3_8_27b_nvfp4.ninfer"],
    "sha256": "74d2c57145e6ff11d1d2faa79594477f9bc903a611af1fb20218189fbbb77d82"
  },
  "backend": "cuda",
  "max-tokens": 1024,
  "temperature": 0,
  "repeat-penalty": 1,
  "no-skills": true,
  "spec": true,
  "spec-type": "block",
  "spec-draft": 7,
  "spec-pmin": 0,
  "environment": {
    "MAX_CONTEXT": "40960",
    "TS_Q35_UBATCH": "2048",
    "TS_SCHED_MAX_RUNNING_SEQS": "4",
    "TS_Q35_NINFER_VERIFY": "1",
    "TS_Q35_GREEDY_VERIFY": "1",
    "TS_SPEC_ADAPTIVE": "0",
    "TS_Q35_NINFER_DRAFT_PTX": "${appBaseDirectory}/cuda_kernels/tensorsharp_q35_ninfer_draft.fatbin"
  }
}

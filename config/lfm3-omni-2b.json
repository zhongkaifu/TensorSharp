{
  // Liquid LFM3-Omni-2B (Q4_K_M) with its multimodal projector (Q8_0): the LFM3 text
  // decoder plus one mmproj holding the image/video tower (lfm3vl), the audio encoder
  // (lfm3a) and the speech generator (lfm3a_gen). Same files as the TensorAgent catalog
  // entry lfm3-omni-2b-q4km (TensorAgent/src/TensorAgent.Core/Catalog/ModelCatalog.Lfm3.cs).
  // Pinned to LiquidAI/LFM3-Omni-2B-GGUF@d508b88f08a5b4286f2d2805a6a8d69a0ff44c72; each SHA-256
  // is the file's LFS object id at that commit. LFM3-Omni-2B-Q4_K_M.gguf: 1099630080 bytes;
  // mmproj-LFM3-Omni-2B-Q8_0.gguf: 506842528 bytes.
  // License: LFM Open License v1.0 (lfm1.0).
  // Run with:
  //   TensorSharp.Cli         --config config/lfm3-omni-2b.json --image photo.png --input prompt.txt
  //   TensorSharp.Server.Host --config config/lfm3-omni-2b.json
  // Omni is not a reasoning model (its template defaults enable_thinking to false). Text
  // chat works without the projector; image, video and audio input need it, and so do spoken
  // replies (/v1/audio/speech, and chat completions or Responses asking for audio; see
  // docs/models/lfm3.md#speech-output). The GGUF declares a 128,000-token window;
  // MAX_CONTEXT (environment) bounds it.
  "variables": {
    "modelRoot": "${TENSORSHARP_MODELS:-../models}",
    "root": "${modelRoot}/lfm3"
  },
  "backend": "ggml_metal",
  "max-tokens": 4096,

  // Text replies: the LFM3 card's general-purpose preset (the LFM3-1.7B card, same LFM3
  // backbone): temperature 0.1, top_k 50, repetition_penalty 1.1 over the whole output, with
  // HF's top_p 1.0 and no min_p. The Omni card and generation_config.json say greedy with no
  // penalty, but decoded that way the 2B model repeats a sentence, a table row or a stanza
  // over and over: on eng/lfm3/loop's 50 en/zh chats 3% of replies under vLLM BF16, 7-10%
  // under llama.cpp Q4_K_M, 7-9% here (the engines agree), and 12-16% with the server's
  // skills on. With this preset 0-3% of the plain replies looped, and GSM8K, IFEval and ASR
  // held (docs/models/lfm3.md#sampling). Speech keeps its own sampling (the mmproj's:
  // temperature 0.4, penalty 1.2 over 64 frames).
  "temperature": 0.1,
  "top-k": 50,
  "top-p": 1,
  "min-p": 0,
  "repeat-penalty": 1.1,
  "repeat-last-n": -1,

  "model": {
    "path": "${root}/LFM3-Omni-2B-Q4_K_M.gguf",
    "urls": [
      "https://huggingface.co/LiquidAI/LFM3-Omni-2B-GGUF/resolve/d508b88f08a5b4286f2d2805a6a8d69a0ff44c72/LFM3-Omni-2B-Q4_K_M.gguf"
    ],
    "sha256": "9f8d30e9d4fd7a9349d586e077988229b3ca0a0e4ad730897563d1eccc9893e2"
  },
  "mmproj": {
    "path": "${root}/mmproj-LFM3-Omni-2B-Q8_0.gguf",
    "urls": [
      "https://huggingface.co/LiquidAI/LFM3-Omni-2B-GGUF/resolve/d508b88f08a5b4286f2d2805a6a8d69a0ff44c72/mmproj-LFM3-Omni-2B-Q8_0.gguf"
    ],
    "sha256": "8a25f9d1931244429de404fccacfb7fb933970a36aa5688d2f5069f29c6b27b1",
    "optional": true
  }
}

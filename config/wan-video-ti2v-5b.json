{
  // Wan 2.2 TI2V-5B (base, undistilled) — text-to-video and image-to-video.
  //
  // Same three networks as the Turbo config, same auto-download:
  //   1. the DiT           (--model)     the denoiser
  //   2. the Wan 2.2 VAE   (--video-vae)   pixels <-> the 48-channel video latent
  //   3. UMT5-XXL          (--video-text-encoder)    the text encoder
  //
  //   TensorSharp.Server.Host --config config/wan-video-ti2v-5b.json
  //
  // This is the REFERENCE recipe: 50 steps with classifier-free guidance, i.e.
  // 100 DiT passes, against Turbo's 4. It is the quality baseline the oracle
  // tests are checked against, and it is roughly 25x slower for a given clip —
  // start with config/wan-video-ti2v-5b-turbo.json unless you specifically want
  // the undistilled sampler.
  //
  // Downloads ~12.9 GB (DiT 5.4 GB, text encoder 6.0 GB, VAE 1.4 GB), pinned by
  // commit and SHA-256.
  "variables": {
    // Override the location with the TENSORSHARP_MODELS environment variable;
    // otherwise ../models, and relative paths in a config resolve against the
    // config file's folder (not the working directory), so that is a "models"
    // folder at the repository root. This file needs no editing on Windows,
    // Linux or macOS.
    "modelRoot": "${TENSORSHARP_MODELS:-../models}",
    "hf": "https://huggingface.co"
  },

  "backend": "ggml_cuda",

  // The official TI2V-5B recipe is 121 frames at 24 fps (5.04 s), 50 steps,
  // cfg 5.0, shift 5.0. Steps/cfg/shift come from the model defaults; only the
  // output length is set here. Drop to 61 frames to make a request ~4x cheaper.
  "video-frames": 121,
  "fps": 24,

  "model": {
    "path": "${modelRoot}/Wan2.2-TI2V-5B-Q8_0.gguf",
    "urls": [ "${hf}/QuantStack/Wan2.2-TI2V-5B-GGUF/resolve/57437632ddd08bdcbd1508c866aa22e126ed51d2/Wan2.2-TI2V-5B-Q8_0.gguf" ],
    "sha256": "57bece983817ab2f957546683bb670f13be7d99022d45674840cd999a050ea8f"
  },

  "video-vae": {
    "path": "${modelRoot}/Wan2.2_VAE.safetensors",
    "urls": [ "${hf}/QuantStack/Wan2.2-TI2V-5B-GGUF/resolve/57437632ddd08bdcbd1508c866aa22e126ed51d2/VAE/Wan2.2_VAE.safetensors" ],
    "sha256": "e40321bd36b9709991dae2530eb4ac303dd168276980d3e9bc4b6e2b75fed156"
  },

  "video-text-encoder": {
    "path": "${modelRoot}/umt5-xxl-encoder-Q8_0.gguf",
    "urls": [ "${hf}/city96/umt5-xxl-encoder-gguf/resolve/b535255bee98c2b0a59ea7c0ae2dcd0c6657b3b7/umt5-xxl-encoder-Q8_0.gguf" ],
    "sha256": "2521d4de0bf9e1cc6549866463ceae85e4ec3239bc6063f7488810be39033bbc"
  }
}

{
  // Liquid LFM3-1.7B (Q4_K_M) — hybrid short-conv + GQA attention text model with
  // reasoning (<think>) and Qwen3-Coder XML tool calls. Same files as the TensorAgent
  // catalog entry lfm3-1.7b-q4km (TensorAgent/src/TensorAgent.Core/Catalog/ModelCatalog.Lfm3.cs).
  // Pinned to LiquidAI/LFM3-1.7B-GGUF@cd0c74c575b5c416f3011b5b4c298077f26ca8c2; the SHA-256 is
  // the file's LFS object id at that commit. LFM3-1.7B-Q4_K_M.gguf: 1099627808 bytes.
  // License: LFM Open License v1.0 (lfm1.0).
  // Run with:
  //   TensorSharp.Cli         --config config/lfm3-1.7b.json --think --input prompt.txt
  //   TensorSharp.Server.Host --config config/lfm3-1.7b.json
  // The model reasons by default under llama.cpp and HF; TensorSharp's think switch
  // defaults off on every host, so pass --think / "think": true (or
  // chat_template_kwargs.enable_thinking) for the model card's default mode.
  // The GGUF declares a 262,144-token window; MAX_CONTEXT (environment) bounds it.
  "variables": {
    "modelRoot": "${TENSORSHARP_MODELS:-../models}",
    "root": "${modelRoot}/lfm3"
  },
  "backend": "ggml_metal",
  "max-tokens": 8192,

  // The model card's general-purpose sampling (chat, tool use, agents, coding), which is
  // also the GGUF's general.sampling.*: temperature 0.1, top_k 50, repetition_penalty 1.1,
  // with HF's top_p 1.0 and no min_p. HF, vLLM and SGLang apply the penalty to the whole
  // output; repeat-last-n -1 does that here (TensorSharp never penalizes prompt tokens).
  // The card's math/STEM preset is temperature 1.0, top-p 0.95, top-k 20.
  "temperature": 0.1,
  "top-k": 50,
  "top-p": 1,
  "min-p": 0,
  "repeat-penalty": 1.1,
  "repeat-last-n": -1,

  "model": {
    "path": "${root}/LFM3-1.7B-Q4_K_M.gguf",
    "urls": [
      "https://huggingface.co/LiquidAI/LFM3-1.7B-GGUF/resolve/cd0c74c575b5c416f3011b5b4c298077f26ca8c2/LFM3-1.7B-Q4_K_M.gguf"
    ],
    "sha256": "3793e1e6e2266919d6e015287221b41100175a98eddaba92e111aed3b05c93c4"
  }
}

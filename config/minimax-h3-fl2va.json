{
  // MiniMax-H3 — joint video + 32 kHz stereo audio generation. This is the FL2VA
  // checkpoint: text-to-video, image-to-video, and first-and-last-frame.
  //
  //   TensorSharp.Server.Host --config config/minimax-h3-fl2va.json
  //
  //   TensorSharp.Cli --config config/minimax-h3-fl2va.json \
  //     --prompt "a red fox trotting through falling snow, cinematic" --output fox.mp4
  //
  // Four networks cooperate, and naming them here is what lets them auto-download
  // into ${modelRoot} on the first run (~35.5 GB in total) and be reused after:
  //   1. the denoiser     (model)               the packed audio-video DiT   10.64 GiB
  //   2. Qwen3-VL-32B     (video-text-encoder)  the text encoder, 50 layers  16.97 GiB
  //   3. the video VAE    (video-vae)           16x spatial / 4x temporal     5.21 GB
  //   4. the audio VAE    (audio-vae)           32 kHz stereo soundtrack      0.61 GB
  // Each is loaded and released in turn, so peak VRAM is max(...) and not the sum.
  // Delete the "audio-vae" entry and you still get video, just silent.
  //
  // THE TOKENIZER IS NOT AUTOMATED. The text-encoder GGUF carries none, and
  // auto-download can only fill in options that are flags — the tokenizer is not
  // one. Put all three files next to the encoder in ${modelRoot} (or point
  // TS_VIDEO_TOKENIZER at whatever folder holds them). tokenizer_config.json is the
  // only one that defines the vision markers: text-to-video runs without it, but an
  // --image / --end-image keyframe is refused before the vision tower runs.
  //   curl -L -o models/vocab.json https://huggingface.co/MiniMaxAI/MiniMax-H3/resolve/42ed227ee7df40d41602854ae760620d6eb651fe/processor/vocab.json
  //   curl -L -o models/merges.txt https://huggingface.co/MiniMaxAI/MiniMax-H3/resolve/42ed227ee7df40d41602854ae760620d6eb651fe/processor/merges.txt
  //   curl -L -o models/tokenizer_config.json https://huggingface.co/MiniMaxAI/MiniMax-H3/resolve/42ed227ee7df40d41602854ae760620d6eb651fe/processor/tokenizer_config.json
  //
  // Steps and guidance are deliberately NOT set here: a shipped config must parse on
  // both hosts, and the two spell steps differently — --video-steps N on the server,
  // --diffusion-steps N on the CLI, and the server takes no --cfg at all. So the
  // model's own defaults apply (20 steps, guidance off). H3 is CFG-distilled: cfg
  // MUST stay 1.0, which the pipeline enforces by refusing anything higher. Fewer base
  // steps cost some chromatic fringing around moving subjects that is gone by ~20.
  //
  // FOR FEWER STEPS, add the LightX2V Turbo plug-in, a step-distillation LoRA made for
  // this checkpoint, instead of lowering the base step count:
  //   TensorSharp.Cli --config config/minimax-h3-fl2va.json \
  //     --lora config/lora/minimax-h3-fl2v-turbo-8step.json --prompt "..." --output clip.mp4
  //   TensorSharp.Server.Host --config config/minimax-h3-fl2va.json \
  //     --lora config/lora/minimax-h3-fl2v-turbo-8step.json
  // It samples exactly 8 steps (minimax-h3-fl2v-turbo-4step.json: 4) on its own schedule,
  // video shift 6 / audio 3, Euler, cfg 1, and its 1.38 GB of weights download on first
  // use. Leave the step count, flow shift and sampler unset with it: any other value is
  // refused at startup, before anything downloads. See docs/models/minimax-h3.md#turbo-plug-ins.
  //
  // The frame count snaps to the 17k+5 grid and fps is pinned to 24.
  //
  // THE SIZE IS LEFT TO THE MODEL, on purpose. Text-to-video runs at 640x384. A
  // keyframe (--image for i2v, --image and --end-image for fl2v) sizes the canvas
  // itself, by MiniMax's released 768p recipe: the first keyframe's aspect at a
  // 768-pixel short edge, so 1152x768 for a 3:2 photo and 1344x768 for 16:9. Those
  // modes keep the keyframe's framing, and the video VAE downsamples 16x each way:
  // fitted to 640x384, a full-body photo leaves a face about 60 px tall, and it comes
  // back smeared and distorted however many steps run. The recipe has about 2.4x
  // (square) to 4.2x (16:9) the video tokens per frame of 640x384, so it takes several
  // times longer. To pin one size for every mode, pass both --width and --height (CLI)
  // or both --video-width and --video-height (server).
  "variables": {
    // Override the location with the TENSORSHARP_MODELS environment variable;
    // otherwise ../models, and relative paths in a config resolve against the
    // config file's folder (not the working directory), so that is a "models"
    // folder at the repository root. This file needs no editing on Windows,
    // Linux or macOS.
    "modelRoot": "${TENSORSHARP_MODELS:-../models}",
    "hf": "https://huggingface.co",
    // Both VAEs are mirrored by Comfy-Org, so each lists two sources: if the first
    // URL fails the next one is tried. The two mirrors serve byte-identical files,
    // so one "sha256" checks either.
    "gguf": "${hf}/unsloth/MiniMax-H3-GGUF/resolve/d629413c2e5b51b38c453668b75ca3b06ca92703",
    "comfy": "${hf}/Comfy-Org/MiniMax-H3/resolve/bf92c4091e333e69b8ca1998e0a669f15cb0832b"
  },

  // Every shipped config names a backend; --backend on the command line wins over
  // it, so `--backend ggml_metal` still runs this file on Apple silicon.
  "backend": "ggml_cuda",

  "model": {
    "path": "${modelRoot}/minimax_h3_fl2va_pruned-Q4_K.gguf",
    "urls": [ "${gguf}/minimax_h3_fl2va_pruned-Q4_K.gguf" ],
    "sha256": "dd948e08ad0ba3c71bd42f368e283dd82e790f5122a63b276e22a3e0283d0c10"
  },

  // Truncated to 50 layers with the final norm removed, and freed before the
  // denoise starts. Swap in -Q2_K_M.gguf (12.20 GiB) to pair with a smaller denoiser:
  // change the name in "path" and "urls" and set "sha256" to
  //   a8ccadccd57ef34c838ffb8a7da8368bb554721b2760274a1d3b0df63960b997
  "video-text-encoder": {
    "path": "${modelRoot}/qwen3vl_32b_minimax_h3-Q4_K_M.gguf",
    "urls": [ "${gguf}/qwen3vl_32b_minimax_h3-Q4_K_M.gguf" ],
    "sha256": "11e6efe70a57ce7f4838c47bdbd1a1c4b8ce10e2b7747f1b065990b70f4b05fc"
  },

  "video-vae": {
    "path": "${modelRoot}/minimax_h3_video_vae_fp16.safetensors",
    "urls": [
      "${gguf}/vae/minimax_h3_video_vae_fp16.safetensors",
      "${comfy}/vae/minimax_h3_video_vae_fp16.safetensors"
    ],
    "sha256": "7c1f131492e7eddacaac9069a61b81bdd39de5cc96561e677c5eab1cdce5e522"
  },

  // Decodes the jointly generated audio latent to 32 kHz stereo, written as a
  // sidecar .wav beside the video.
  "audio-vae": {
    "path": "${modelRoot}/minimax_h3_audio_vae_fp32.safetensors",
    "urls": [
      "${gguf}/vae/minimax_h3_audio_vae_fp32.safetensors",
      "${comfy}/vae/minimax_h3_audio_vae_fp32.safetensors"
    ],
    "sha256": "8e505d95dd1561d47abd43d4238fd40d9bb1ae9e147ed0a4cba778d76ae4db48"
  },

  "video-frames": 22,
  "fps": 24
}

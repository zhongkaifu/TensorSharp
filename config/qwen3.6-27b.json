{
  // Qwen3.6-27B (UD-IQ2_XXS) — dense multimodal LLM (~9.6 GB) plus its
  // vision projector, so it can read images. The trunk + mmproj are co-located
  // under ${modelRoot}/mtp.
  // Run with:
  //   TensorSharp.Cli    --config config/qwen3.6-27b.json --image photo.png
  //   TensorSharp.Server --config config/qwen3.6-27b.json
  "variables": {
    "modelRoot": "${TENSORSHARP_MODELS:-../models}",
    "root": "${TENSORSHARP_MODELS:-../models}/mtp",
    // unsloth's -MTP build: the one that carries the embedded NextN block.
    "repo": "https://huggingface.co/unsloth/Qwen3.6-27B-MTP-GGUF/resolve/5cb35eb3dcbf52dbce5f87dbc64df6aaffadcace"
  },

  "backend": "ggml_cuda",
  "max-tokens": 4096,
  "continuous-batching": true,

  "temperature": 0.7,
  "top-k": 20,
  "top-p": 0.8,
  "min-p": 0,

  "model": {
    "path": "${root}/Qwen3.6-27B-UD-IQ2_XXS.gguf",
    "urls": ["${repo}/Qwen3.6-27B-UD-IQ2_XXS.gguf"],
    "sha256": "844907b21d12669ce23de622e13d923581112b465f245bee1d0d84d519327b6f"
  },
  "mmproj": {
    "path": "${root}/Qwen3.6-27B-mmproj-BF16.gguf",
    "urls": ["${repo}/mmproj-BF16.gguf"],
    "sha256": "05353347512982ee62317b9d8c89372bc815f4b4043580e7ef3ad411ec1a1cd3"
  }

  // MTP speculative decoding: Qwen3.6 embeds its NextN draft head in the trunk
  // GGUF, so no separate draft file is needed — enable it on either host with:
  //   "spec": true
  // It is lossless (verify step guarantees identical output); whether it is
  // faster than plain decode depends on the workload, so measure before pinning.
}

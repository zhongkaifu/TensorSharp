{
  // Viggle Turbo v0.2.1: a DMD2 / SenseFlow step-distillation LoRA for Qwen-Image-2.1.
  // Text-to-image and editing (1-3 reference images) in 6 transformer passes instead of
  // 40, with CFG off. The r128 file is the r256 adapter truncated by SVD ("same usage").
  //
  //   TensorSharp.Cli --config config/qwen-image-2.1.json \
  //       --lora config/lora/qwen-image-2.1-viggle-turbo.json --prompt "..." --width 1024 --height 1024
  //
  // Recipe (model card, Viggle/Qwen-Image-2.1-viggle-turbo): raw sigma nodes
  // [1, 0.9375, 0.875, 0.75, 0.5, 0.25] passed through the checkpoint's resolution-dependent
  // exponential shift WITHOUT the base scheduler's shift_terminal ("it would wreck the last
  // step"), then a terminal 0; true_cfg_scale 1; LoRA strength 1 (alpha = rank). Other step
  // counts follow the card's rule: split 1 -> 0.875 evenly and keep 0.875, 0.75, 0.5, 0.25
  // (the demo Space's raw_nodes). 4 steps is the training schedule.
  // License: Qwen Research License (non-commercial); see the model card.
  "type": "qwen-image-2.1-lora",
  "variables": {
    "root": "${TENSORSHARP_MODELS:-../../models}/qwen-image-2.1/loras"
  },
  "weights": {
    "path": "${root}/Qwen-Image-2.1-viggle-turbo-v0.2.1-6step-lora-r128.safetensors",
    "urls": ["https://huggingface.co/Viggle/Qwen-Image-2.1-viggle-turbo/resolve/bb26a0f38e5fe6c124aaccc9187a87eed5d9ed13/Qwen-Image-2.1-viggle-turbo-v0.2.1-6step-lora-r128.safetensors"],
    "sha256": "bafb91d0047df3f9b8a5a850b0c967f051164314d8aad778dfa34d9c24ec345b"
  },
  "scale": 1.0,
  "sampling": {
    "steps": 6,
    "shift": "dynamic",
    "cfg": 1.0,
    "sigmas": {
      "4": [1.0, 0.75, 0.5, 0.25],
      "5": [1.0, 0.875, 0.75, 0.5, 0.25],
      "6": [1.0, 0.9375, 0.875, 0.75, 0.5, 0.25],
      "7": [1.0, 0.9583333, 0.9166667, 0.875, 0.75, 0.5, 0.25],
      "8": [1.0, 0.96875, 0.9375, 0.90625, 0.875, 0.75, 0.5, 0.25]
    }
  }
}

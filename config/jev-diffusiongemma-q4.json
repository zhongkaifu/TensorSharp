{
  // Native Jev-compatible POST /v1/systemone using a seeded, one-step
  // DiffusionGemma logit read. No separate bridge or tokenizer download.
  // Downloads the Q4_K_M model from Unsloth on first use and reuses it afterward.
  // Defaults to ../models relative to this config; set TENSORSHARP_MODELS to
  // use another model directory, then run:
  // dotnet run --project TensorSharp.Server.Host -c Release -- --config config/jev-diffusiongemma-q4.json
  // Sampling/read controls belong in the JSON request, not chat sampler flags.
  // "files", "documents", "videos" and "audios" accept {name,data} inline
  // base64 or {file} references returned by POST /api/upload. The existing
  // "images" base64 array remains supported. TS_JEV_MAX_BODY_MB (default 8)
  // caps the JSON body; upload references avoid base64/body overhead.
  // MAX_CONTEXT is environment-only and limits prompt + canvas tokens. Set it
  // before launch for your memory budget (for example, $env:MAX_CONTEXT='4096').
  // On a 16 GiB CUDA GPU, reserve activation space before launch with
  // $env:DIFFUSION_VRAM_HEADROOM_MB='4096'; tune this for your device/workload.
  // Without it the checkpoint's declared context limit applies. max-tokens below
  // caps ordinary chat output, not Jev input length or answer-canvas width.
  "variables": {
    "modelRoot": "${TENSORSHARP_MODELS:-../models}"
  },
  "model": {
    "path": "${modelRoot}/diffusiongemma-26B-A4B-it-Q4_K_M.gguf",
    "urls": [
      "https://huggingface.co/unsloth/diffusiongemma-26B-A4B-it-GGUF/resolve/f4183a2c7a354128d02545752303c4354d165bf0/diffusiongemma-26B-A4B-it-Q4_K_M.gguf"
    ],
    "sha256": "24523b6c833c9ce9f5f34f9b333ab1517d73d6f1e76a103645353114c8028bc5"
  },
  // Vision tower for images, scanned document pages and sampled video frames.
  // Each image is encoded here and read as part of the state. Without this
  // entry, text/documents with extractable text still work, but requests
  // needing image rows receive 503 rather than answers that ignore the pixels.
  //
  // Every published GGUF of this checkpoint is TEXT-ONLY, and no mmproj was
  // released for it; the upstream repo does carry the tower, and all 356 of its
  // tensors live in this one 2.8 GB shard (of an 11-shard, 51.6 GB checkpoint),
  // so this downloads that shard alone, on the first run, and reuses it. To run
  // text-only decisions and skip the download entirely, pass --mmproj none on
  // the command line: a command-line value replaces this entry before it is
  // resolved, so the shard is never fetched, and "none" loads no projector.
  //
  // Video uses up to four sampled frames per clip; soundtrack is not read.
  // Audio needs a separately running ASR service: set TS_JEV_TRANSCRIPTION_URL
  // to its full endpoint (e.g. http://127.0.0.1:8178/inference) before launch.
  // It must accept multipart file,response_format=json and return {"text":...}.
  // Optional: TS_JEV_TRANSCRIPTION_MODEL, TS_JEV_TRANSCRIPTION_API_KEY,
  // TS_JEV_TRANSCRIPTION_TIMEOUT_SECONDS (default 120). Only speech transcripts
  // reach this model; it has no audio tower. Missing ASR returns 503.
  // See docs/models/jev.md for formats, limits, examples and validation.
  "mmproj": {
    "path": "${modelRoot}/diffusiongemma-26B-A4B-it-vision.safetensors",
    "urls": [
      "https://huggingface.co/google/diffusiongemma-26B-A4B-it/resolve/f7f5b7f5fa82ffc52addd066915886d497f5517b/model-00011-of-00011.safetensors"
    ],
    "sha256": "afec047176bb2a05f078566576aec6bdb71ad4d041275d0d0c89473fda6d6d87"
  },
  "backend": "ggml_cuda",
  "host": "127.0.0.1",
  "port": 5000,
  "max-tokens": 256
}
